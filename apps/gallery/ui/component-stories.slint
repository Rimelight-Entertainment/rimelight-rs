// ScrollArea (P0.17 batch 3): a 160 px area over twelve lines of text, with the scrollbar at the top.
export component ScrollAreaStory inherits VerticalLayout {
    in property <bool> pt: false;
    in property <int> variant: 0;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: "Scroll area"; }

    CaptionRow { caption: "Twelve lines";
        ScrollArea {
            width: 240px;
            height: 160px;
            VerticalLayout {
                width: parent.width;
                spacing: Tokens.space-1;
                for n in 12 : Text {
                    text: "Line \{n + 1} of the scrolling region";
                    color: Tokens.text-primary;
                    font-family: Type.body.family;
                    font-size: Type.body.size;
                    font-weight: Type.body.weight;
                }
            }
        }
    }
}

// ResizablePanel (P0.17 batch 3): a panel with its handle on the right edge, at its default width.
export component ResizablePanelStory inherits VerticalLayout {
    in property <bool> pt: false;
    in property <int> variant: 0;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: "Resizable panel"; }

    CaptionRow { caption: "Handle on the right";
        ResizablePanel {
            height: 120px;
            size: 240px;
            forced-state: 2;
            Text {
                x: Tokens.space-4;
                y: Tokens.space-4;
                text: "Panel contents";
                color: Tokens.text-primary;
                font-family: Type.body.family;
                font-size: Type.body.size;
                font-weight: Type.body.weight;
            }
        }
    }
}

