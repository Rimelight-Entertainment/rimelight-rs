    }
}

// Sheet (S8): a trigger Button and the Sheet, which covers the window when open and slides in from its edge.
component SheetDemo inherits Rectangle {
    in property <bool> pt: false;
    in property <int> open-tick: 0;
    in property <SheetPlacement> placement: SheetPlacement.right;
    in property <length> host-width: 10000px;
    in property <length> host-height: 10000px;

    height: Tokens.size-control-md;
    width: 160px;

    changed open-tick => {
        trig.focus-me();
        sh.open();
    }

    trig := Button {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: root.pt ? "Abrir" : "Open";
        variant: ButtonVariant.secondary;
        clicked => {
            trig.focus-me();
            sh.open();
        }
    }

    sh := Sheet {
        title: root.pt ? "Detalhes" : "Details";
        description: root.pt ? "Edite os dados do item." : "Edit the item's details.";
        placement: root.placement;
        host-width: root.host-width;
        host-height: root.host-height;
        actions: [
            { text: root.pt ? "Cancelar" : "Cancel", variant: ButtonVariant.secondary },
            { text: root.pt ? "Salvar" : "Save", variant: ButtonVariant.primary },
        ];

        action-clicked(index) => {
            sh.close();
        }

        VerticalLayout {
            spacing: Tokens.space-3;
            Input {
                placeholder: root.pt ? "Nome" : "Name";
                accessible-name: root.pt ? "Nome" : "Name";
            }
            Input {
                placeholder: root.pt ? "Descricao" : "Description";
                accessible-name: root.pt ? "Descricao" : "Description";
            }
        }
    }
}

