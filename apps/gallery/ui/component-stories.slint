    SectionCaption { text: root.pt ? "Variantes e tamanhos: sm 28, md 34, lg 40" : "Variants and sizes: sm 28, md 34, lg 40"; }
    VerticalLayout {
        spacing: Tokens.space-3;
        SizeRow { caption: "primary"; variant: ButtonVariant.primary; }
        SizeRow { caption: "secondary"; variant: ButtonVariant.secondary; }
        SizeRow { caption: "ghost"; variant: ButtonVariant.ghost; }
        SizeRow { caption: "danger"; variant: ButtonVariant.danger; }
        SizeRow { caption: "link"; variant: ButtonVariant.link; }
    }

    SectionCaption { text: root.pt ? "Estados" : "States"; }
    VerticalLayout {
        spacing: Tokens.space-3;
        StateRow { caption: "primary"; variant: ButtonVariant.primary; }
        StateRow { caption: "secondary"; variant: ButtonVariant.secondary; }
        StateRow { caption: "ghost"; variant: ButtonVariant.ghost; }
        StateRow { caption: "danger"; variant: ButtonVariant.danger; }
        StateRow { caption: "link"; variant: ButtonVariant.link; }
    }

    SectionCaption { text: root.pt ? "ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¾Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Âcones" : "Icons"; }
    VerticalLayout {
        spacing: Tokens.space-3;
        CaptionRow {
            caption: "leading";
            Button { text: "Add"; leading-icon: Icons.plus; }
            Button { text: "Add"; variant: ButtonVariant.primary; leading-icon: Icons.plus; size: ButtonSize.lg; }
        }
        CaptionRow {
            caption: "trailing";
            Button { text: "Next"; trailing-icon: Icons.chevron-right; }
            Button { text: "Open"; variant: ButtonVariant.primary; trailing-icon: Icons.external-link; }
        }
        CaptionRow {
            caption: "both";
            Button { text: "Back"; leading-icon: Icons.chevron-left; trailing-icon: Icons.chevron-right; }
        }
    }

    SectionCaption { text: root.pt ? "Largura total" : "Full width"; }
    Button { text: root.pt ? "Salvar" : "Save"; variant: ButtonVariant.primary; full-width: true; }

    SectionCaption { text: root.pt ? "Sobre a barra lateral azul" : "On the navy sidebar"; }
    Rectangle {
        background: Tokens.sidebar-bg;
        border-radius: Tokens.radius-surface;
        height: 120px;
        VerticalLayout {
            padding: Tokens.space-4;
            spacing: Tokens.space-3;
            alignment: start;
            HorizontalLayout {
                spacing: Tokens.space-3;
                alignment: start;
                Button { text: "Ghost"; variant: ButtonVariant.ghost; on-sidebar: true; }
                Button { text: "Ghost hover"; variant: ButtonVariant.ghost; on-sidebar: true; forced-state: 1; }
                Button { text: "Link"; variant: ButtonVariant.link; on-sidebar: true; }
            }
            HorizontalLayout {
                spacing: Tokens.space-3;
                alignment: start;
                Button { text: "Primary"; variant: ButtonVariant.primary; }
                Button { text: "Secondary"; variant: ButtonVariant.secondary; }
                Button { text: "Danger"; variant: ButtonVariant.danger; }
            }
        }
    }
}

// An icon-only button in one variant, at the three sizes.
component IconSizeRow inherits CaptionRow {
    in property <ButtonVariant> variant;
    IconButton { icon: Icons.plus; label: "Add"; tooltip: "Add"; variant: root.variant; size: ButtonSize.sm; }
    IconButton { icon: Icons.plus; label: "Add"; tooltip: "Add"; variant: root.variant; size: ButtonSize.md; }
    IconButton { icon: Icons.plus; label: "Add"; tooltip: "Add"; variant: root.variant; size: ButtonSize.lg; }
}

// An icon-only button in every state.
component IconStateRow inherits CaptionRow {
    in property <ButtonVariant> variant;
    IconButton { icon: Icons.x; label: "Close"; tooltip: "Close"; variant: root.variant; }
    IconButton { icon: Icons.x; label: "Close"; tooltip: "Close"; variant: root.variant; forced-state: 1; }
    IconButton { icon: Icons.x; label: "Close"; tooltip: "Close"; variant: root.variant; forced-state: 3; }
    IconButton { icon: Icons.x; label: "Close"; tooltip: "Close"; variant: root.variant; enabled: false; }
    IconButton { icon: Icons.x; label: "Close"; tooltip: "Close"; variant: root.variant; loading: true; }
}

