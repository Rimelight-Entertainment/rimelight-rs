        AttachmentGrid {
            width: 520px;
            items: [
                { name: "screenshot.png", size: "240 KB", is-image: true, thumbnail: @image-url("../assets/stories/avatar-sample.svg"), changeable: true },
                { name: "build-log.txt", size: "12 KB", is-image: false, changeable: true },
                { name: "plan.pdf", size: "1.4 MB", is-image: false, changeable: false },
            ];
        }
    }
}

export component ColorPickerStory inherits VerticalLayout {
    in property <bool> pt: false;
    property <color> field-colour: #1659C4;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: root.pt ? "Selector de cor" : "ColorPicker"; }

    SectionCaption { text: root.pt ? "Selector" : "Picker"; }
