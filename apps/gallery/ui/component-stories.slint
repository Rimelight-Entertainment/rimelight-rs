// A caption above its control, stacked, so a row fits a 390 px phone (no fixed caption column).
component StackedRow inherits VerticalLayout {
    in property <string> caption;
    spacing: Tokens.space-2;
    Text {
        text: root.caption;
        color: Tokens.text-muted;
        font-family: Type.caption.family;
        font-size: Type.caption.size;
        font-weight: Type.caption.weight;
    }
    @children
}

// Input (S5): every size, the icons, the addon, clear and password, every state, and the sample text. The forced states
// (hover and focus ring) are set by the story so a capture shows them without a pointer. Each field is at most 280 px wide
// and every row stacks, so the story fits a 390 px phone.
export component InputStory inherits VerticalLayout {
    in property <bool> pt: false;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: root.pt ? "Campo de texto" : "Input"; }

    SectionCaption { text: root.pt ? "Tamanhos" : "Sizes"; }
    StackedRow { caption: "sm (28 px)";
        Input { max-width: 280px; placeholder: "28 px"; size: InputSize.sm; accessible-name: "Small"; }
    }
    StackedRow { caption: "md (34 px)";
        Input { max-width: 280px; placeholder: "34 px"; size: InputSize.md; accessible-name: "Medium"; }
    }
    StackedRow { caption: "lg (40 px)";
        Input { max-width: 280px; placeholder: "40 px"; size: InputSize.lg; accessible-name: "Large"; }
    }

    SectionCaption { text: root.pt ? "Estados" : "States"; }
    StackedRow { caption: "default";
        Input { max-width: 280px; placeholder: "Name"; accessible-name: "Name default"; }
    }
    StackedRow { caption: "hover";
        Input { max-width: 280px; placeholder: "Name"; accessible-name: "Name hover"; forced-state: 1; }
    }
    StackedRow { caption: "focus";
        Input { max-width: 280px; text: "Ada"; accessible-name: "Name focus"; forced-state: 2; }
    }
    StackedRow { caption: "disabled";
        Input { max-width: 280px; text: "Ada"; enabled: false; accessible-name: "Name disabled"; }
    }
    StackedRow { caption: "read-only";
        Input { max-width: 280px; text: "Ada"; read-only: true; accessible-name: "Name read-only"; }
    }
    StackedRow { caption: "invalid";
        Input { max-width: 280px; text: "ada@"; invalid: true; accessible-name: "Email invalid"; }
    }

    SectionCaption { text: root.pt ? "Icones, sufixo, limpar e senha" : "Icons, addon, clear and password"; }
    StackedRow { caption: "leading icon";
        Input { max-width: 280px; placeholder: "Email"; leading-icon: Icons.mail; accessible-name: "Email"; }
    }
    StackedRow { caption: "addon";
        Input { max-width: 280px; text: "example"; trailing-addon: ".dev"; accessible-name: "Domain"; }
    }
    StackedRow { caption: "clearable";
        Input { max-width: 280px; text: "Ada Lovelace"; clearable: true; clear-label: "Clear name"; accessible-name: "Name clearable"; }
    }
    StackedRow { caption: "password";
        Input { max-width: 280px; text: "secret"; password: true; accessible-name: "Password"; }
    }
}

