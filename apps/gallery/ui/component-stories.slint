// Action component stories (S3): Button, IconButton, ButtonGroup and Link, with every variant,
// size and state, in the light and dark themes. The gallery (gallery.slint) shows one at a time, in the order of the Rust
// registry (apps/gallery/src/registry.rs). The forced states (hover, pressed, focus) are set by the story, not by input, so a
// capture shows them without a pointer.
import { Tokens } from "@rimelight_design/tokens.slint";
import { Type } from "@rimelight_ui/typography.slint";
import { Icons } from "@rimelight_ui/icons.slint";
import { Button, ButtonVariant, ButtonSize } from "@rimelight_ui/components/button.slint";
import { IconButton } from "@rimelight_ui/components/icon-button.slint";
import { ButtonGroup, GroupSegment } from "@rimelight_ui/components/button-group.slint";
import { Link } from "@rimelight_ui/components/link.slint";
import { Badge, BadgeTone, ToneColours } from "@rimelight_ui/components/badge.slint";
import { Tag } from "@rimelight_ui/components/tag.slint";
import { Kbd } from "@rimelight_ui/components/kbd.slint";
import { TooltipPlacement } from "@rimelight_ui/components/tooltip.slint";
import { Popover } from "@rimelight_ui/components/popover.slint";
import { Menu, ContextMenu, MenuItem, MenuKind, MenuChecked } from "@rimelight_ui/components/menu.slint";
import { Input, InputSize } from "@rimelight_ui/components/input.slint";
import { SearchField } from "@rimelight_ui/components/search-field.slint";
import { Textarea } from "@rimelight_ui/components/textarea.slint";
import { NumberInput } from "@rimelight_ui/components/number-input.slint";
import { Field, Form as FieldForm } from "@rimelight_ui/components/field.slint";
import { Checkbox, CheckState, CheckboxSize } from "@rimelight_ui/components/checkbox.slint";
import { RadioGroup, RadioOrientation } from "@rimelight_ui/components/radio-group.slint";
import { Switch, SwitchSize, SwitchLabelSide } from "@rimelight_ui/components/switch.slint";
import { Slider } from "@rimelight_ui/components/slider.slint";
import { ColorPicker, ColorField } from "@rimelight_ui/components/color-picker.slint";
import { Select, SelectOption, SelectSize } from "@rimelight_ui/components/select.slint";
import { Combobox } from "@rimelight_ui/components/combobox.slint";
import { Button, ButtonVariant } from "@rimelight_ui/components/button.slint";
import { Avatar, AvatarStack, AvatarSize, Presence, AvatarItem } from "@rimelight_ui/components/avatar.slint";
import { DescriptionList, DescriptionItem } from "@rimelight_ui/components/description-list.slint";
import { Stat, DeltaDirection } from "@rimelight_ui/components/stat.slint";
import { Timeline, TimelineEvent } from "@rimelight_ui/components/timeline.slint";
import { ActivityFeed, ActivityItem } from "@rimelight_ui/components/activity-feed.slint";
import { List, ListRow } from "@rimelight_ui/components/list.slint";
import { Table, TableColumn, TableRow } from "@rimelight_ui/components/table.slint";
import { Divider } from "@rimelight_ui/components/divider.slint";
import { Skeleton, SkeletonShape } from "@rimelight_ui/components/skeleton.slint";
import { Spinner, SpinnerSize } from "@rimelight_ui/components/spinner.slint";
import { Progress } from "@rimelight_ui/components/progress.slint";
import { EmptyState } from "@rimelight_ui/components/empty-state.slint";
import { ErrorState } from "@rimelight_ui/components/error-state.slint";
import { Dialog, ConfirmDialog } from "@rimelight_ui/components/dialog.slint";
import { Sheet, SheetPlacement } from "@rimelight_ui/components/sheet.slint";
import { ImageViewer, ImageViewerItem } from "@rimelight_ui/components/image-viewer.slint";
import { AttachmentGrid, AttachmentItem } from "@rimelight_ui/components/attachment-tile.slint";
import { ToastStack, ToastEntry, ToastTone } from "@rimelight_ui/components/toast.slint";
import { Banner, BannerTone } from "@rimelight_ui/components/banner.slint";
import { Card, CardSurface } from "@rimelight_ui/components/card.slint";
import { Section } from "@rimelight_ui/components/section.slint";
import { StatusDot } from "@rimelight_ui/components/status-dot.slint";
import { PresenceDot } from "@rimelight_ui/components/presence-dot.slint";
import { Breadcrumbs } from "@rimelight_ui/components/breadcrumbs.slint";
import { Tabs, ContentTab } from "@rimelight_ui/components/content-tabs.slint";
import { Accordion, AccordionEntry } from "@rimelight_ui/components/accordion.slint";
import { Stepper, StepItem } from "@rimelight_ui/components/stepper.slint";
import { Pagination } from "@rimelight_ui/components/pagination.slint";
import { Toolbar, ToolbarItem } from "@rimelight_ui/components/toolbar.slint";
import { FilterBar, FilterChip } from "@rimelight_ui/components/filter-bar.slint";
import { Tree, TreeRow } from "@rimelight_ui/components/tree.slint";
import { ScrollArea } from "@rimelight_ui/components/scroll-area.slint";
import { ResizablePanel } from "@rimelight_ui/components/resizable-panel.slint";

component StoryHeading inherits Text {
    color: Tokens.text-primary;
    font-family: Type.heading.family;
    font-size: Type.heading.size;
    font-weight: Type.heading.weight;
    wrap: word-wrap;
}

// A caption on the left and its controls on the right, on one line.
component CaptionRow inherits HorizontalLayout {
    in property <string> caption;
    spacing: Tokens.space-4;
    alignment: start;
    Text {
        width: 140px;
        text: root.caption;
        color: Tokens.text-muted;
        font-family: Type.caption.family;
        font-size: Type.caption.size;
        font-weight: Type.caption.weight;
        wrap: word-wrap;
        vertical-alignment: center;
    }
    @children
}

// A section caption above its rows.
component SectionCaption inherits Text {
    color: Tokens.text-muted;
    font-family: Type.caption.family;
    font-size: Type.caption.size;
    font-weight: Type.caption.weight;
}

// One variant in the three sizes.
component SizeRow inherits CaptionRow {
    in property <ButtonVariant> variant;
    Button { text: "Label"; variant: root.variant; size: ButtonSize.sm; }
    Button { text: "Label"; variant: root.variant; size: ButtonSize.md; }
    Button { text: "Label"; variant: root.variant; size: ButtonSize.lg; }
}

// One variant in every state: rest, hover, pressed, focus ring, disabled and loading.
component StateRow inherits CaptionRow {
    in property <ButtonVariant> variant;
    Button { text: "Rest"; variant: root.variant; }
    Button { text: "Hover"; variant: root.variant; forced-state: 1; }
    Button { text: "Pressed"; variant: root.variant; forced-state: 2; }
    Button { text: "Focus"; variant: root.variant; forced-state: 3; }
    Button { text: "Disabled"; variant: root.variant; enabled: false; }
    Button { text: "Loading"; variant: root.variant; loading: true; }
}

export component ButtonStory inherits VerticalLayout {
    in property <bool> pt: false;
    spacing: Tokens.space-6;
    alignment: start;

