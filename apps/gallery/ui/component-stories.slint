            description: root.pt ? "Verifique a conexÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â£o e tente de novo." : "Check your connection and try again.";
            retry-label: root.pt ? "Tentar de novo" : "Try again";
            details: "HTTP 503 from /api/projects";
        }
    }

    SectionCaption { text: root.pt ? "Sem nova tentativa" : "Without retry"; }
    Rectangle {
        border-width: 1px;
        border-color: Tokens.border-subtle;
        border-radius: Tokens.radius-surface;
        background: Tokens.surface-raised;
