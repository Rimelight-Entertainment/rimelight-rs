// Toast (S8): the stack, drawn inline. A story has no countdown (the Rust queue owns it), so the toasts stay until closed.
export component ToastStory inherits VerticalLayout {
    in property <bool> pt: false;
    in property <int> variant: 0;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: "Toast"; }

    if root.variant == 0 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        SectionCaption { text: "Every tone"; }
        ToastStack {
            toasts: [
                { id: 1, tone: ToastTone.neutral, title: "Sync started", description: "", action-label: "", close-label: "Dismiss sync", closing: false },
                { id: 2, tone: ToastTone.success, title: "Saved", description: "Your changes are in.", action-label: "", close-label: "Dismiss saved", closing: false },
                { id: 3, tone: ToastTone.warning, title: "Storage almost full", description: "About 90 percent of your quota is used.", action-label: "", close-label: "Dismiss storage", closing: false },
                { id: 4, tone: ToastTone.danger, title: "Upload failed", description: "The file was not saved.", action-label: "", close-label: "Dismiss upload", closing: false },
                { id: 5, tone: ToastTone.info, title: "New version available", description: "", action-label: "", close-label: "Dismiss update", closing: false },
            ];
            host-width: root.width + 2 * Tokens.space-4;
            label: "Notifications";
        }
    }

    if root.variant == 1 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        SectionCaption { text: "Stack of three, newest first; danger has an action"; }
        ToastStack {
            toasts: [
                { id: 1, tone: ToastTone.danger, title: "Upload failed", description: "The file was not saved.", action-label: "Retry", close-label: "Dismiss upload", closing: false },
                { id: 2, tone: ToastTone.warning, title: "Storage almost full", description: "", action-label: "Manage storage", close-label: "Dismiss storage", closing: false },
                { id: 3, tone: ToastTone.success, title: "Saved", description: "Your changes are in.", action-label: "", close-label: "Dismiss saved", closing: false },
            ];
            host-width: root.width + 2 * Tokens.space-4;
            label: "Notifications";
        }
    }
}

// Banner (S8): an inline bar in the page flow. Every tone; with and without description, action and dismiss; compact.
export component BannerStory inherits VerticalLayout {
    in property <bool> pt: false;
    in property <int> variant: 0;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: "Banner"; }

    if root.variant == 0 : VerticalLayout {
        spacing: Tokens.space-3;
        alignment: start;

        SectionCaption { text: "Every tone"; }
        Banner { tone: BannerTone.neutral; title: "Scheduled maintenance on Friday"; description: "The sync service pauses for about ten minutes."; }
        Banner { tone: BannerTone.success; title: "Export finished"; description: "The file is in your downloads folder."; }
        Banner { tone: BannerTone.warning; title: "Storage almost full"; description: "About 90 percent of your quota is used."; }
        Banner { tone: BannerTone.danger; title: "Upload failed"; description: "The file was not saved."; }
        Banner { tone: BannerTone.info; title: "New version available"; description: "Restart the app to update."; }
    }

    if root.variant == 1 : VerticalLayout {
        spacing: Tokens.space-3;
        alignment: start;

        SectionCaption { text: "With and without description, action and dismiss"; }
        Banner { tone: BannerTone.danger; title: "Upload failed"; description: "The file was not saved."; action-label: "Retry"; dismiss-label: "Dismiss"; }
        Banner { tone: BannerTone.warning; title: "Storage almost full"; action-label: "Manage storage"; }
        Banner { tone: BannerTone.info; title: "Sync paused"; description: "Changes wait on this device."; dismiss-label: "Dismiss"; }
        Banner { tone: BannerTone.success; title: "Saved"; }
    }

    if root.variant == 2 : VerticalLayout {
        spacing: Tokens.space-2;
        alignment: start;

        SectionCaption { text: "Compact, every tone"; }
        Banner { compact: true; tone: BannerTone.neutral; title: "Neutral"; action-label: "Open"; }
        Banner { compact: true; tone: BannerTone.success; title: "Success"; }
        Banner { compact: true; tone: BannerTone.warning; title: "Warning"; dismiss-label: "Dismiss"; }
        Banner { compact: true; tone: BannerTone.danger; title: "Danger"; action-label: "Retry"; }
        Banner { compact: true; tone: BannerTone.info; title: "Info"; }
    }
}

