// Badge (S4): every tone as a count and as a dot, the cap rule, and the navy sidebar surface.
export component BadgeStory inherits VerticalLayout {
    in property <bool> pt: false;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: root.pt ? "Distintivo" : "Badge"; }

    SectionCaption { text: root.pt ? "Contagem, todos os tons" : "Count, every tone"; }
    CaptionRow {
        caption: "count 7";
        Badge { count: 7; tone: BadgeTone.neutral; }
        Badge { count: 7; tone: BadgeTone.accent; }
        Badge { count: 7; tone: BadgeTone.success; }
        Badge { count: 7; tone: BadgeTone.warning; }
        Badge { count: 7; tone: BadgeTone.danger; }
        Badge { count: 7; tone: BadgeTone.info; }
    }

    SectionCaption { text: root.pt ? "Ponto, todos os tons" : "Dot, every tone"; }
    CaptionRow {
        caption: "dot";
        Badge { dot: true; tone: BadgeTone.neutral; }
        Badge { dot: true; tone: BadgeTone.accent; }
        Badge { dot: true; tone: BadgeTone.success; }
        Badge { dot: true; tone: BadgeTone.warning; }
        Badge { dot: true; tone: BadgeTone.danger; }
