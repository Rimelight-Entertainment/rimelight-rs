}
// Field and Form (S5): a field with help, a required field, an error, and a complete small form (name, email, notes,
// quantity, and a Save button) that stacks at phone width.
export component FieldStory inherits VerticalLayout {
    in property <bool> pt: false;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: root.pt ? "Campo e formulario" : "Field and Form"; }

    SectionCaption { text: root.pt ? "Estados" : "States"; }
    FieldForm {
        Field { label: "Name"; required: true;
            Input { placeholder: "Full name"; accessible-name: "Name"; }
        }
        Field { label: "Email"; help: "We never share it.";
            Input { placeholder: "you@example.com"; leading-icon: Icons.mail; accessible-name: "Email help"; }
        }
        Field { label: "Email"; error: "Enter a valid email address.";
            Input { text: "ada@"; invalid: true; accessible-name: "Email error"; }
        }
    }

    SectionCaption { text: root.pt ? "Formulario completo" : "Complete form"; }
    FieldForm {
        Field { label: "Name"; required: true;
            Input { text: "Ada Lovelace"; accessible-name: "Full name"; }
        }
        Field { label: "Email"; required: true; help: "Used for invoices.";
            Input { placeholder: "you@example.com"; leading-icon: Icons.mail; accessible-name: "Work email"; }
        }
        Field { label: "Notes";
            Textarea { placeholder: "Anything else"; rows: 3; accessible-name: "Notes"; }
        }
        Field { label: "Quantity";
            NumberInput { value: 2; text: "2"; minimum: 0; maximum: 10; accessible-name: "Quantity"; }
        }
        Button { text: "Save"; variant: ButtonVariant.primary; }
    }
}

// Choice controls (S5): Checkbox, RadioGroup, Switch and Slider, each in its states and in a Field.
// Forced states (focus ring 2, hover) show a state without a pointer; the in-field examples show the error look.
export component CheckboxStory inherits VerticalLayout {
    in property <bool> pt: false;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: root.pt ? "Caixa de selecao" : "Checkbox"; }

    SectionCaption { text: root.pt ? "Tamanhos e estados" : "Sizes and states"; }
    CaptionRow {
        caption: "md";
        Checkbox { text: "Unchecked"; accessible-name: "Unchecked md"; }
        Checkbox { text: "Checked"; check-state: CheckState.checked; accessible-name: "Checked md"; }
        Checkbox { text: "Mixed"; check-state: CheckState.indeterminate; accessible-name: "Mixed md"; }
    }
    CaptionRow {
        caption: "sm";
        Checkbox { text: "Unchecked"; size: CheckboxSize.sm; accessible-name: "Unchecked sm"; }
        Checkbox { text: "Checked"; size: CheckboxSize.sm; check-state: CheckState.checked; accessible-name: "Checked sm"; }
        Checkbox { text: "Mixed"; size: CheckboxSize.sm; check-state: CheckState.indeterminate; accessible-name: "Mixed sm"; }
    }
    CaptionRow {
        caption: "disabled";
        Checkbox { text: "Unchecked"; enabled: false; accessible-name: "Disabled unchecked"; }
        Checkbox { text: "Checked"; enabled: false; check-state: CheckState.checked; accessible-name: "Disabled checked"; }
        Checkbox { text: "Mixed"; enabled: false; check-state: CheckState.indeterminate; accessible-name: "Disabled mixed"; }
    }
    CaptionRow {
        caption: "invalid";
        Checkbox { text: "Accept terms"; invalid: true; accessible-name: "Invalid"; }
    }
    CaptionRow {
        caption: "focus";
        Checkbox { text: "Focused"; check-state: CheckState.checked; forced-state: 2; accessible-name: "Focus"; }
    }

    SectionCaption { text: root.pt ? "Em um campo" : "In a field"; }
    FieldForm {
        Field { label: "Newsletter"; help: "One email a month.";
            Checkbox { text: "Send me the newsletter"; accessible-name: "Newsletter"; }
        }
        fld2 := Field { label: "Terms"; error: "You must accept the terms.";
            Checkbox { text: "I accept the terms"; invalid: fld2.invalid; accessible-name: "Terms"; }
        }
    }
}

export component RadioGroupStory inherits VerticalLayout {
    in property <bool> pt: false;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: root.pt ? "Grupo de opcoes" : "RadioGroup"; }

    SectionCaption { text: root.pt ? "Vertical e horizontal" : "Vertical and horizontal"; }
    CaptionRow {
        caption: "vertical";
        RadioGroup {
            value: "beta";
            accessible-name: "Vertical";
            options: [
                { value: "alpha", label: "Alpha", disabled: false },
                { value: "beta", label: "Beta", disabled: false },
                { value: "gamma", label: "Gamma (disabled)", disabled: true },
            ];
        }
    }
    CaptionRow {
        caption: "horizontal";
        RadioGroup {
            value: "alpha";
            orientation: RadioOrientation.horizontal;
            accessible-name: "Horizontal";
            options: [
                { value: "alpha", label: "Alpha", disabled: false },
                { value: "beta", label: "Beta", disabled: false },
                { value: "gamma", label: "Gamma", disabled: false },
            ];
        }
    }

    SectionCaption { text: root.pt ? "Estados" : "States"; }
    CaptionRow {
        caption: "none selected";
        RadioGroup {
            value: "";
            accessible-name: "None";
            options: [
                { value: "one", label: "One", disabled: false },
                { value: "two", label: "Two", disabled: false },
            ];
        }
    }
    CaptionRow {
        caption: "disabled";
        RadioGroup {
            value: "one";
            enabled: false;
            accessible-name: "Disabled";
            options: [
                { value: "one", label: "One", disabled: false },
                { value: "two", label: "Two", disabled: false },
            ];
        }
    }
    CaptionRow {
        caption: "invalid";
        RadioGroup {
            value: "";
            invalid: true;
            accessible-name: "Invalid";
            options: [
                { value: "one", label: "One", disabled: false },
                { value: "two", label: "Two", disabled: false },
            ];
        }
    }
    CaptionRow {
        caption: "focus";
        RadioGroup {
            value: "two";
            forced-state: 2;
            accessible-name: "Focus";
            options: [
                { value: "one", label: "One", disabled: false },
                { value: "two", label: "Two", disabled: false },
            ];
        }
    }

    SectionCaption { text: root.pt ? "Em um campo" : "In a field"; }
    FieldForm {
        Field { label: "Plan"; help: "You can change it later.";
            RadioGroup {
                value: "free";
                accessible-name: "Plan";
                options: [
                    { value: "free", label: "Free", disabled: false },
                    { value: "pro", label: "Pro", disabled: false },
                ];
            }
        }
        fld4 := Field { label: "Plan"; error: "Choose a plan.";
            RadioGroup {
                value: "";
                invalid: fld4.invalid;
                accessible-name: "Plan error";
                options: [
                    { value: "free", label: "Free", disabled: false },
                    { value: "pro", label: "Pro", disabled: false },
                ];
            }
        }
    }
}

export component SwitchStory inherits VerticalLayout {
    in property <bool> pt: false;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: root.pt ? "Chave" : "Switch"; }

    SectionCaption { text: root.pt ? "Tamanhos e lados do rotulo" : "Sizes and label side"; }
    CaptionRow {
        caption: "md, right";
        Switch { text: "Off"; accessible-name: "Off md"; }
        Switch { text: "On"; checked: true; accessible-name: "On md"; }
    }
    CaptionRow {
        caption: "md, left";
        Switch { text: "Off"; label-side: SwitchLabelSide.left; accessible-name: "Off left"; }
        Switch { text: "On"; checked: true; label-side: SwitchLabelSide.left; accessible-name: "On left"; }
    }
    CaptionRow {
        caption: "sm";
        Switch { text: "Off"; size: SwitchSize.sm; accessible-name: "Off sm"; }
        Switch { text: "On"; size: SwitchSize.sm; checked: true; accessible-name: "On sm"; }
    }

    SectionCaption { text: root.pt ? "Estados" : "States"; }
    CaptionRow {
        caption: "disabled";
        Switch { text: "Off"; enabled: false; accessible-name: "Disabled off"; }
        Switch { text: "On"; enabled: false; checked: true; accessible-name: "Disabled on"; }
    }
    CaptionRow {
        caption: "focus";
        Switch { text: "Focused"; checked: true; forced-state: 2; accessible-name: "Focus"; }
    }

    SectionCaption { text: root.pt ? "Em um campo" : "In a field"; }
    FieldForm {
        Field { label: "Notifications"; help: "Email me when something changes.";
            Switch { text: "Email updates"; accessible-name: "Email"; }
        }
    }
}

export component SliderStory inherits VerticalLayout {
    in property <bool> pt: false;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: root.pt ? "Controle deslizante" : "Slider"; }

    SectionCaption { text: root.pt ? "Faixa e valor" : "Range and value"; }
    CaptionRow {
        caption: "0 to 100, step 10";
        Slider { value: 40; minimum: 0; maximum: 100; step: 10; show-value: true; accessible-name: "Volume"; }
    }
    CaptionRow {
        caption: "step 1";
        Slider { value: 7; minimum: 0; maximum: 10; step: 1; show-value: true; accessible-name: "Stars"; }
    }

    SectionCaption { text: root.pt ? "Estados" : "States"; }
    CaptionRow {
        caption: "disabled";
        Slider { value: 30; minimum: 0; maximum: 100; step: 10; enabled: false; accessible-name: "Disabled"; }
    }
    CaptionRow {
        caption: "focus";
        Slider { value: 60; minimum: 0; maximum: 100; step: 10; forced-state: 2; accessible-name: "Focus"; }
    }

    SectionCaption { text: root.pt ? "Em um campo" : "In a field"; }
    FieldForm {
        Field { label: "Volume"; help: "Between 0 and 100.";
            Slider { value: 50; minimum: 0; maximum: 100; step: 5; show-value: true; accessible-name: "Field volume"; }
        }
    }
}

// Select (S6): the default story has every size, state, the icons, clearable and a Field. The open variants show the menu:
// "open" with a highlight that differs from the chosen row (groups and a disabled option are in the menu), and "flip" with
// the trigger at the bottom edge of the story, so the menu opens upward. The variant is set by the gallery.
export component SelectStory inherits VerticalLayout {
    in property <bool> pt: false;
    // 0 default, 1 open, 2 flip (see the registry in apps/gallery/src/registry.rs).
    in property <int> variant: 0;
    spacing: Tokens.space-6;
    alignment: start;

    property <[SelectOption]> fruit: [
        { value: "apple", label: "Apple", disabled: false, group: "Pome" },
        { value: "apricot", label: "Apricot", disabled: true, group: "Stone" },
        { value: "banana", label: "Banana", disabled: false, group: "Tropical" },
        { value: "blueberry", label: "Blueberry", disabled: false, group: "Berries" },
        { value: "cherry", label: "Cherry", disabled: true, group: "Stone" },
    ];
    property <[SelectOption]> contacts: [
        { value: "mail", label: "Email", icon: Icons.mail, disabled: false, group: "" },
        { value: "calendar", label: "Calendar", icon: Icons.calendar, disabled: false, group: "" },
        { value: "users", label: "Team", icon: Icons.users, disabled: true, group: "" },
    ];

    if root.variant == 0 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        StoryHeading { text: root.pt ? "Seleção" : "Select"; }

        // Two columns, so every state is inside one frame (a capture does not scroll). Each Select is at most 280 px wide.
        HorizontalLayout {
            horizontal-stretch: 1;
            // Two 160 px columns and this gap fit a 390 px phone frame (342 px of content).
            spacing: Tokens.space-4;
            VerticalLayout {
            horizontal-stretch: 1;
            spacing: Tokens.space-6;
            alignment: start;

        SectionCaption { text: root.pt ? "Tamanhos" : "Sizes"; }
        StackedRow { caption: "sm (28 px)";
            Select { max-width: 280px; size: SelectSize.sm; value: "banana"; options: root.fruit; accessible-name: "Small"; }
        }
        StackedRow { caption: "md (34 px)";
            Select { max-width: 280px; size: SelectSize.md; value: "banana"; options: root.fruit; accessible-name: "Medium"; }
        }
        StackedRow { caption: "lg (40 px)";
            Select { max-width: 280px; size: SelectSize.lg; value: "banana"; options: root.fruit; accessible-name: "Large"; }
        }

        SectionCaption { text: root.pt ? "Estados" : "States"; }
        StackedRow { caption: "placeholder";
            Select { max-width: 280px; placeholder: "Pick a fruit"; options: root.fruit; accessible-name: "Fruit placeholder"; }
        }
        StackedRow { caption: "hover";
            Select { max-width: 280px; value: "banana"; options: root.fruit; forced-state: 1; accessible-name: "Fruit hover"; }
        }
        StackedRow { caption: "focus";
            Select { max-width: 280px; value: "banana"; options: root.fruit; forced-state: 2; accessible-name: "Fruit focus"; }
        }
            }
            VerticalLayout {
            horizontal-stretch: 1;
            spacing: Tokens.space-6;
            alignment: start;

        StackedRow { caption: "disabled";
            Select { max-width: 280px; value: "banana"; options: root.fruit; enabled: false; accessible-name: "Fruit disabled"; }
        }
        StackedRow { caption: "invalid";
            Select { max-width: 280px; placeholder: "Pick a fruit"; options: root.fruit; invalid: true; accessible-name: "Fruit invalid"; }
        }

        SectionCaption { text: root.pt ? "Icones, limpar e campo" : "Icons, clear and field"; }
        StackedRow { caption: "leading icons";
            Select { max-width: 280px; value: "calendar"; options: root.contacts; accessible-name: "Contact"; }
        }
        StackedRow { caption: "clearable";
            Select { max-width: 280px; value: "blueberry"; options: root.fruit; clearable: true; accessible-name: "Fruit clearable"; }
        }
        StackedRow { caption: "in a field";
            Field { label: root.pt ? "Fruta" : "Fruit"; help: root.pt ? "Escolha uma." : "Choose one.";
                Select { max-width: 280px; placeholder: "Pick a fruit"; options: root.fruit; accessible-name: "Field fruit"; }
            }
        }
        StackedRow { caption: "in a field, error";
            fld := Field { label: root.pt ? "Fruta" : "Fruit"; error: root.pt ? "Escolha uma fruta." : "Choose a fruit.";
                Select { max-width: 280px; placeholder: "Pick a fruit"; options: root.fruit; invalid: fld.invalid; accessible-name: "Field fruit error"; }
            }
        }
            }
        }
    }

    // The menu is open, the highlight is on Banana and the chosen row is Apple. Groups and a disabled row are in the menu.
    if root.variant == 1 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        StoryHeading { text: root.pt ? "Seleção aberta" : "Select open"; }
        SectionCaption { text: root.pt ? "Destaque diferente da escolha" : "Highlight differs from the chosen row"; }
        Select { max-width: 280px; value: "apple"; options: root.fruit; forced-open: true; forced-highlight: 2; accessible-name: "Fruit open"; }
    }

    // The trigger sits at the bottom edge of the story: there is no room below, so the menu opens upward.
    if root.variant == 2 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        StoryHeading { text: root.pt ? "Seleção no fim da tela" : "Select at the bottom edge"; }
        Rectangle { height: 240px; }
        SectionCaption { text: root.pt ? "Abre para cima" : "Opens upward: no room below"; }
        Select { max-width: 280px; value: "banana"; options: root.fruit; forced-open: true; forced-highlight: 3;
            bottom-limit: root.absolute-position.y + root.height; accessible-name: "Fruit flip"; }
    }
}

// Combobox (S6): the default states, then the open menu (filter empty), the filtered menu (the filter has "e"), and the
// no-results line (the filter has "kiwi", and the caller's words are shown). The filter is typed text in the captures.
export component ComboboxStory inherits VerticalLayout {
    in property <bool> pt: false;
    // 0 default, 1 open, 2 filtered, 3 no results (see the registry in apps/gallery/src/registry.rs).
    in property <int> variant: 0;
    spacing: Tokens.space-6;
    alignment: start;

    property <[SelectOption]> fruit: [
        { value: "apple", label: "Apple", disabled: false, group: "Pome" },
        { value: "apricot", label: "Apricot", disabled: true, group: "Stone" },
        { value: "banana", label: "Banana", disabled: false, group: "Tropical" },
        { value: "blueberry", label: "Blueberry", disabled: false, group: "Berries" },
        { value: "cherry", label: "Cherry", disabled: true, group: "Stone" },
    ];

    if root.variant == 0 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        StoryHeading { text: "Combobox"; }

        // Two columns, so every state is inside one frame (a capture does not scroll).
        HorizontalLayout {
            horizontal-stretch: 1;
            // Two 160 px columns and this gap fit a 390 px phone frame (342 px of content).
            spacing: Tokens.space-4;
            VerticalLayout {
            horizontal-stretch: 1;
            spacing: Tokens.space-6;
            alignment: start;

        SectionCaption { text: root.pt ? "Tamanhos" : "Sizes"; }
        StackedRow { caption: "sm (28 px)";
            Combobox { max-width: 280px; size: SelectSize.sm; value: "banana"; options: root.fruit; accessible-name: "Small"; }
        }
        StackedRow { caption: "md (34 px)";
            Combobox { max-width: 280px; size: SelectSize.md; value: "banana"; options: root.fruit; accessible-name: "Medium"; }
        }
        StackedRow { caption: "lg (40 px)";
            Combobox { max-width: 280px; size: SelectSize.lg; value: "banana"; options: root.fruit; accessible-name: "Large"; }
        }

        SectionCaption { text: root.pt ? "Estados" : "States"; }
        StackedRow { caption: "placeholder";
            Combobox { max-width: 280px; placeholder: "Pick a fruit"; options: root.fruit; accessible-name: "Fruit placeholder"; }
        }
        StackedRow { caption: "hover";
            Combobox { max-width: 280px; value: "banana"; options: root.fruit; forced-state: 1; accessible-name: "Fruit hover"; }
        }
        StackedRow { caption: "focus";
            Combobox { max-width: 280px; value: "banana"; options: root.fruit; forced-state: 2; accessible-name: "Fruit focus"; }
        }
            }
            VerticalLayout {
            horizontal-stretch: 1;
            spacing: Tokens.space-6;
            alignment: start;

        StackedRow { caption: "disabled";
            Combobox { max-width: 280px; value: "banana"; options: root.fruit; enabled: false; accessible-name: "Fruit disabled"; }
        }
        StackedRow { caption: "invalid";
            Combobox { max-width: 280px; placeholder: "Pick a fruit"; options: root.fruit; invalid: true; accessible-name: "Fruit invalid"; }
        }
        StackedRow { caption: "in a field";
            Field { label: root.pt ? "Fruta" : "Fruit"; help: root.pt ? "Digite para filtrar." : "Type to filter.";
                Combobox { max-width: 280px; placeholder: "Pick a fruit"; options: root.fruit; accessible-name: "Field fruit"; }
            }
        }
            }
        }
    }

    // The menu is open with an empty filter; the highlight is on Banana, the chosen row is Apple.
    if root.variant == 1 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        StoryHeading { text: root.pt ? "Combobox aberto" : "Combobox open"; }
        SectionCaption { text: root.pt ? "Filtro vazio, destaque diferente da escolha" : "Empty filter, highlight differs from the chosen row"; }
        Combobox { max-width: 280px; value: "apple"; options: root.fruit; forced-open: true; forced-highlight: 2;
            filter-placeholder: root.pt ? "Buscar" : "Search"; accessible-name: "Fruit open"; }
    }

    // The filter has "e": Apple, Blueberry and the disabled Cherry match.
    if root.variant == 2 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        StoryHeading { text: root.pt ? "Combobox filtrado" : "Combobox filtered"; }
        SectionCaption { text: root.pt ? "Filtro com e" : "Filter has e"; }
        Combobox { max-width: 280px; value: "banana"; options: root.fruit; forced-open: true; forced-filter: "e";
            filter-placeholder: root.pt ? "Buscar" : "Search"; accessible-name: "Fruit filtered"; }
    }

    // The filter has "kiwi", which no option matches: the caller's no-results words are shown.
    if root.variant == 3 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        StoryHeading { text: root.pt ? "Combobox sem resultado" : "Combobox no results"; }
        SectionCaption { text: root.pt ? "Filtro sem correspondencia" : "Filter with no match"; }
        Combobox { max-width: 280px; value: "banana"; options: root.fruit; forced-open: true; forced-filter: "kiwi";
            filter-placeholder: root.pt ? "Buscar" : "Search";
            no-results-text: root.pt ? "Nenhuma fruta encontrada." : "No fruit matches."; accessible-name: "Fruit none"; }
    }
}

// Tooltip (S7): the anchor is an IconButton and its `tooltip` is the text. 0 default: no focus and no hover, so nothing is
// drawn. 1 focus: the anchor has keyboard focus (forced here), so the tooltip is shown above it with its shortcut. 2 bottom:
// the same anchor with the tooltip placed below it.
export component TooltipStory inherits VerticalLayout {
    in property <bool> pt: false;
    // 0 default, 1 focus, 2 bottom (see the registry in apps/gallery/src/registry.rs).
    in property <int> variant: 0;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: root.pt ? "Dica de ferramenta" : "Tooltip"; }

    if root.variant == 0 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        SectionCaption { text: root.pt ? "Sem foco e sem ponteiro" : "No focus, no pointer"; }
        HorizontalLayout {
            spacing: Tokens.space-6;
            alignment: start;
            IconButton { icon: Icons.plus; label: root.pt ? "Adicionar" : "Add"; tooltip: root.pt ? "Adicionar item" : "Add item"; tooltip-shortcut: ["Ctrl", "N"]; }
            IconButton { icon: Icons.x; label: root.pt ? "Fechar" : "Close"; tooltip: root.pt ? "Fechar" : "Close"; }
        }
    }

    // The anchor has keyboard focus, so the tooltip is drawn above it with the shortcut hint.
    if root.variant == 1 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        SectionCaption { text: root.pt ? "Foco do teclado: acima" : "Keyboard focus: above"; }
        Rectangle { height: 48px; }
        HorizontalLayout {
            spacing: Tokens.space-6;
            alignment: start;
            // Indented, so the bubble (centred on the anchor) stays inside the story frame.
            Rectangle { width: 120px; }
            IconButton { icon: Icons.plus; label: root.pt ? "Adicionar" : "Add"; tooltip: root.pt ? "Adicionar item" : "Add item"; tooltip-shortcut: ["Ctrl", "N"]; forced-state: 3; }
        }
    }

    // The same, placed below the anchor (the bottom placement, also what a flip gives when there is no room above).
    if root.variant == 2 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        SectionCaption { text: root.pt ? "Foco do teclado: abaixo" : "Keyboard focus: below"; }
        HorizontalLayout {
            spacing: Tokens.space-6;
            alignment: start;
            IconButton { icon: Icons.x; label: root.pt ? "Fechar" : "Close"; tooltip: root.pt ? "Fechar painel" : "Close panel"; forced-state: 3; tooltip-placement: TooltipPlacement.bottom; }
        }
    }
}

// Popover (S7): a trigger Button and the panel (Popover, @children). 0 default: the trigger with the panel closed. 1 open:
// the panel is open below the trigger, with an Input and two Buttons. 2 flip: the trigger sits at the bottom edge of the
// story, so the panel opens upward (the bottom-limit is the trigger's bottom edge). See the registry in apps/gallery/src/registry.rs.
component PopoverDemo inherits Rectangle {
    in property <bool> pt: false;
    // Each change opens the panel (the gallery opens it after the first layout, see AfterRender::OpenPopover).
    in property <int> open-tick: 0;
    changed open-tick => {
        pop.open();
    }
    // True when the trigger is at the bottom edge of the window: the panel opens upward.
    in property <bool> flip: false;
    property <string> name: "";

    height: Tokens.size-control-md;
    width: 160px;

    trig := Button {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: root.pt ? "Renomear" : "Rename";
        variant: ButtonVariant.secondary;
        pointer-pressed => { pop.trigger-pressed(); }
        clicked => {
            trig.focus-me();
            pop.trigger-clicked();
        }
    }

    pop := Popover {
        accessible-name: root.pt ? "Renomear" : "Rename";
        anchor-height: trig.height;
        panel-width: 280px;
        bottom-limit: root.flip ? root.absolute-position.y + trig.height : 0px;

        VerticalLayout {
            spacing: Tokens.space-3;
            Input {
                text: root.name;
                placeholder: root.pt ? "Nome" : "Name";
                accessible-name: root.pt ? "Nome" : "Name";
            }
            HorizontalLayout {
                spacing: Tokens.space-2;
                alignment: end;
                Button { text: root.pt ? "Cancelar" : "Cancel"; variant: ButtonVariant.secondary; }
                Button { text: root.pt ? "Salvar" : "Save"; variant: ButtonVariant.primary; }
            }
        }
    }
}

export component PopoverStory inherits VerticalLayout {
    in property <bool> pt: false;
    in property <int> open-tick: 0;
    // 0 default, 1 open, 2 flip (see the registry in apps/gallery/src/registry.rs).
    in property <int> variant: 0;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: "Popover"; }

    if root.variant == 0 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        SectionCaption { text: root.pt ? "Fechado" : "Closed"; }
        PopoverDemo { pt: root.pt; }
    }

    // The panel is open below the trigger: an Input and two Buttons inside it.
    if root.variant == 1 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        SectionCaption { text: root.pt ? "Aberto abaixo do gatilho" : "Open below the trigger"; }
        PopoverDemo { pt: root.pt; open-tick: root.open-tick; }
    }

    // The trigger sits at the bottom edge: there is no room below, so the panel opens upward.
    if root.variant == 2 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        SectionCaption { text: root.pt ? "Abre para cima: sem espaco abaixo" : "Opens upward: no room below"; }
        Rectangle { height: 220px; }
        PopoverDemo { pt: root.pt; open-tick: root.open-tick; flip: true; }
    }
}

// Menu (S7): a Button trigger and the Menu. 0 default: the trigger with the menu closed. 1 open: every kind of row (icon,
// shortcut, checked, disabled, danger, separator, heading, a submenu). 2 submenu: the same menu with the "More" submenu
// expanded. The open variants open after the first layout (AfterRender::OpenPopover, see apps/gallery/src/registry.rs).
component MenuDemo inherits Rectangle {
    in property <bool> pt: false;
    // Each change opens the menu (the gallery opens it after the first layout).
    in property <int> open-tick: 0;
    // 0: the submenu is closed. 2: the "More" submenu is expanded.
    in property <int> variant: 0;

    property <[MenuItem]> items: [
        { id: "undo", kind: MenuKind.item, label: "Undo", shortcut: "Ctrl+Z", disabled: true, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "new", kind: MenuKind.item, label: "New file", icon: Icons.plus, shortcut: "Ctrl+N", disabled: false, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "sep1", kind: MenuKind.separator, label: "", shortcut: "", disabled: false, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "h-view", kind: MenuKind.heading, label: "View", shortcut: "", disabled: false, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "wrap", kind: MenuKind.item, label: "Word wrap", shortcut: "", disabled: false, danger: false, checked: MenuChecked.on, parent: "" },
        { id: "minimap", kind: MenuKind.item, label: "Minimap", shortcut: "", disabled: false, danger: false, checked: MenuChecked.off, parent: "" },
        { id: "hidden", kind: MenuKind.item, label: "Hidden files", shortcut: "", disabled: true, danger: false, checked: MenuChecked.off, parent: "" },
        { id: "sep2", kind: MenuKind.separator, label: "", shortcut: "", disabled: false, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "more", kind: MenuKind.submenu, label: "More", shortcut: "", disabled: false, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "duplicate", kind: MenuKind.item, label: "Duplicate", shortcut: "Ctrl+D", disabled: false, danger: false, checked: MenuChecked.none, parent: "more" },
        { id: "export", kind: MenuKind.item, label: "Export", shortcut: "", disabled: false, danger: false, checked: MenuChecked.none, parent: "more" },
        { id: "print", kind: MenuKind.item, label: "Print", shortcut: "Ctrl+P", disabled: true, danger: false, checked: MenuChecked.none, parent: "more" },
        { id: "delete", kind: MenuKind.item, label: "Delete", shortcut: "Del", disabled: false, danger: true, checked: MenuChecked.none, parent: "" },
    ];

    changed open-tick => {
        menu.open();
    }

    width: 240px;
    height: Tokens.size-control-md;

    trig := Button {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: root.pt ? "Ações" : "Actions";
        variant: ButtonVariant.secondary;
        down-pressed => { menu.open(); }
        pointer-pressed => { menu.trigger-pressed(); }
        clicked => {
            trig.focus-me();
            menu.trigger-clicked();
        }
    }

    menu := Menu {
        accessible-name: root.pt ? "Ações" : "Actions";
        anchor-height: trig.height;
        menu-width: 240px;
        items: root.items;
        expanded-id: root.variant == 2 ? "more" : "";
    }
}

export component MenuStory inherits VerticalLayout {
    in property <bool> pt: false;
    in property <int> open-tick: 0;
    // 0 default, 1 open, 2 submenu (see the registry in apps/gallery/src/registry.rs).
    in property <int> variant: 0;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: "Menu"; }

    if root.variant == 0 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        SectionCaption { text: root.pt ? "Fechado" : "Closed"; }
        MenuDemo { pt: root.pt; }
    }

    if root.variant == 1 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        SectionCaption { text: root.pt ? "Aberto: ícone, atalho, marcado, desabilitado, perigo, separador, cabeçalho, submenu" : "Open: icon, shortcut, checked, disabled, danger, separator, heading, submenu"; }
        MenuDemo { pt: root.pt; open-tick: root.open-tick; }
    }

    if root.variant == 2 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        SectionCaption { text: root.pt ? "Submenu aberto" : "Submenu open"; }
        MenuDemo { pt: root.pt; open-tick: root.open-tick; variant: 2; }
    }
}

// ContextMenu (S7): a target area that opens the menu on a right press at the pointer, or on the Menu key and Shift+F10.
// Its menu is opened after the first layout by open-tick, at (40, 40) inside the target.
component ContextMenuDemo inherits Rectangle {
    in property <bool> pt: false;
    in property <int> open-tick: 0;

    property <[MenuItem]> items: [
        { id: "cut", kind: MenuKind.item, label: "Cut", shortcut: "Ctrl+X", disabled: false, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "copy", kind: MenuKind.item, label: "Copy", shortcut: "Ctrl+C", disabled: false, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "paste", kind: MenuKind.item, label: "Paste", shortcut: "Ctrl+V", disabled: true, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "sep1", kind: MenuKind.separator, label: "", shortcut: "", disabled: false, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "pin", kind: MenuKind.item, label: "Pin to top", shortcut: "", disabled: false, danger: false, checked: MenuChecked.on, parent: "" },
        { id: "sep2", kind: MenuKind.separator, label: "", shortcut: "", disabled: false, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "delete", kind: MenuKind.item, label: "Delete", shortcut: "Del", disabled: false, danger: true, checked: MenuChecked.none, parent: "" },
    ];

    changed open-tick => {
        cm.open-at(40px, 40px);
    }

    width: 320px;
    height: 200px;

    cm := ContextMenu {
        width: parent.width;
        height: parent.height;
        accessible-name: root.pt ? "Arquivo" : "File";
        menu-width: 220px;
        items: root.items;

        Rectangle {
            background: Tokens.surface-raised;
            border-color: Tokens.border-subtle;
            border-width: 1px;
            border-radius: Tokens.radius-surface;

            Text {
                text: root.pt ? "Clique com o botão direito" : "Right-click here, or press the Menu key";
                color: Tokens.text-muted;
                font-family: Type.body.family;
                font-size: Type.body.size;
                font-weight: Type.body.weight;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component ContextMenuStory inherits VerticalLayout {
    in property <bool> pt: false;
    in property <int> open-tick: 0;
    // 0 default, 1 open (see the registry in apps/gallery/src/registry.rs).
    in property <int> variant: 0;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: "ContextMenu"; }

    if root.variant == 0 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        SectionCaption { text: root.pt ? "Fechado" : "Closed"; }
        ContextMenuDemo { pt: root.pt; }
    }

    if root.variant == 1 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        SectionCaption { text: root.pt ? "Aberto no ponteiro" : "Open at the pointer"; }
        ContextMenuDemo { pt: root.pt; open-tick: root.open-tick; }
    }
}

// Dialog (S8): a trigger Button and the Dialog, which covers the window when open. Each open variant opens after the
// first layout (AfterRender::OpenPopover). The trigger takes focus before the dialog opens (the caller contract).
component DialogDemo inherits Rectangle {
    in property <bool> pt: false;
    in property <int> open-tick: 0;
    in property <bool> dismissible: true;
    in property <length> host-width: 10000px;
    in property <length> host-height: 10000px;
    property <string> name: "";

    height: Tokens.size-control-md;
    width: 160px;

    changed open-tick => {
        trig.focus-me();
        dlg.open();
    }

    trig := Button {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: root.pt ? "Abrir" : "Open";
        variant: ButtonVariant.secondary;
        clicked => {
            trig.focus-me();
            dlg.open();
        }
    }

    dlg := Dialog {
        title: root.pt ? "Renomear projeto" : "Rename project";
        description: root.pt ? "O nome aparece na lista de projetos." : "The name shows in the project list.";
        dismissible: root.dismissible;
        host-width: root.host-width;
        host-height: root.host-height;
        actions: [
            { text: root.pt ? "Cancelar" : "Cancel", variant: ButtonVariant.secondary },
            { text: root.pt ? "Salvar" : "Save", variant: ButtonVariant.primary },
        ];

        action-clicked(index) => {
            dlg.close();
        }

        VerticalLayout {
            spacing: Tokens.space-3;
            Input {
                text: root.name;
                placeholder: root.pt ? "Nome" : "Name";
                accessible-name: root.pt ? "Nome" : "Name";
            }
            Input {
                text: root.name;
                placeholder: root.pt ? "Descricao" : "Description";
                accessible-name: root.pt ? "Descricao" : "Description";
            }
        }
    }
}

// ConfirmDialog (S8): a destructive confirmation. The confirm action is drawn as a danger button.
component ConfirmDemo inherits Rectangle {
    in property <bool> pt: false;
    in property <int> open-tick: 0;
    in property <length> host-width: 10000px;
    in property <length> host-height: 10000px;

    height: Tokens.size-control-md;
    width: 160px;

    changed open-tick => {
        trig.focus-me();
        dlg.open();
    }

    trig := Button {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: root.pt ? "Excluir" : "Delete";
        variant: ButtonVariant.secondary;
        clicked => {
            trig.focus-me();
            dlg.open();
        }
    }

    dlg := ConfirmDialog {
        title: root.pt ? "Excluir arquivo?" : "Delete file?";
        message: root.pt ? "O arquivo sera removido. Esta acao nao pode ser desfeita." : "The file will be removed. This cannot be undone.";
        confirm-label: root.pt ? "Excluir" : "Delete";
        cancel-label: root.pt ? "Cancelar" : "Cancel";
        danger: true;
        host-width: root.host-width;
        host-height: root.host-height;
    }
}

export component DialogStory inherits VerticalLayout {
    in property <bool> pt: false;
    in property <int> open-tick: 0;
