// List (P0.17 batch 5). The rows come from the caller; the gallery passes 10,000 generated labels.
export component ListStory inherits VerticalLayout {
    in property <bool> pt: false;
    in property <int> variant: 0;
    in property <[ListRow]> rows;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: "List"; }

    CaptionRow { caption: "10,000 rows";
        List { width: 320px; height: 240px; rows: root.rows; accessible-name: "Entries"; }
    }
}

// Table (P0.17 batch 5). The columns and rows come from the caller; the gallery passes 10,000 generated rows. The story
// shows the rows unsorted and with no selection: sorting, selection and resizing are wired by the caller.
export component TableStory inherits VerticalLayout {
    in property <bool> pt: false;
    in property <int> variant: 0;
    in property <[TableColumn]> columns;
    in property <[TableRow]> rows;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: "Table"; }

    CaptionRow { caption: "10,000 rows";
        Table { width: 640px; height: 320px; columns: root.columns; rows: root.rows; accessible-name: "Items"; }
    }
}

// ImageViewer (new): a trigger Button and the viewer, which covers the window when open. The sample pictures are the
// avatar sample. `open-tick` opens the viewer after the first layout (AfterRender::OpenPopover).
component ImageViewerDemo inherits Rectangle {
    in property <bool> pt: false;
    in property <int> open-tick: 0;
    in property <bool> single: false;
    in property <length> host-width: 10000px;
    in property <length> host-height: 10000px;

    height: Tokens.size-control-md;
    width: 160px;

    changed open-tick => {
        trig.focus-me();
        viewer.open();
    }

    trig := Button {
        x: 0px;
        y: 0px;
        width: parent.width;
        text: root.pt ? "Abrir" : "Open";
        variant: ButtonVariant.secondary;
        clicked => {
            trig.focus-me();
            viewer.open();
        }
    }

    viewer := ImageViewer {
        images: root.single
            ? [{ image: @image-url("../assets/stories/avatar-sample.svg"), title: "avatar.svg" }]
            : [
                { image: @image-url("../assets/stories/avatar-sample.svg"), title: "avatar.svg" },
                { image: @image-url("../assets/stories/avatar-sample.svg"), title: "avatar-2.svg" },
                { image: @image-url("../assets/stories/avatar-sample.svg"), title: "avatar-3.svg" },
            ];
        host-width: root.host-width;
        host-height: root.host-height;
    }
}

// ImageViewer (new). 0 open (three images: arrows and "n of m"), 1 single (one image: no arrows, no counter).
export component ImageViewerStory inherits VerticalLayout {
    in property <bool> pt: false;
    in property <int> open-tick: 0;
    // 0 open, 1 single (see the registry in apps/gallery/src/registry.rs).
    in property <int> variant: 0;
    in property <length> host-width: 10000px;
    in property <length> host-height: 10000px;
    spacing: Tokens.space-6;
    alignment: start;

    StoryHeading { text: "ImageViewer"; }

    if root.variant == 0 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        SectionCaption { text: root.pt ? "Varias imagens" : "Several images"; }
        ImageViewerDemo { pt: root.pt; open-tick: root.open-tick; host-width: root.host-width; host-height: root.host-height; }
    }

    if root.variant == 1 : VerticalLayout {
        spacing: Tokens.space-6;
        alignment: start;

        SectionCaption { text: root.pt ? "Uma imagem" : "One image"; }
        ImageViewerDemo { pt: root.pt; open-tick: root.open-tick; single: true; host-width: root.host-width; host-height: root.host-height; }
    }
}

// AttachmentGrid (new): image attachments show a thumbnail, other files a file icon, name and size.
