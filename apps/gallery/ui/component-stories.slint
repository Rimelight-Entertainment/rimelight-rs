        caption: "square, hue, notations";
        ColorPicker { color: #1659C4; accessible-name: "Colour"; }
    }

    SectionCaption { text: root.pt ? "Campo" : "Field"; }
    CaptionRow {
        caption: "opens a popover";
        ColorField { width: 220px; color <=> root.field-colour; accessible-name: "Area colour"; }
