// Lucide icons (icon::IconName). One image per mapped icon, named by its Lucide name. The files are in
// assets/icons (ISC, see assets/icons/LICENSE). The test `every_icon_has_a_file` checks this list against IconName.
// Icons are monochrome: set `colorize` on the Image to tint them (size tokens: size-icon-small/medium/large).
import { Tokens } from "@rimelight_design/tokens.slint";

export global Icons {
    // Icon sizes scale with the text scale (decision 0008 (c)): the size tokens times the text factor.
    out property <length> small-size: Tokens.icon-small * Tokens.text-factor;
    out property <length> medium-size: Tokens.icon-medium * Tokens.text-factor;
    out property <length> large-size: Tokens.icon-large * Tokens.text-factor;
    out property <image> house: @image-url("../assets/icons/house.svg");
    out property <image> message-square: @image-url("../assets/icons/message-square.svg");
    out property <image> mail: @image-url("../assets/icons/mail.svg");
    out property <image> calendar: @image-url("../assets/icons/calendar.svg");
    out property <image> folder-kanban: @image-url("../assets/icons/folder-kanban.svg");
    out property <image> building-2: @image-url("../assets/icons/building-2.svg");
    out property <image> users: @image-url("../assets/icons/users.svg");
    out property <image> landmark: @image-url("../assets/icons/landmark.svg");
