    out property <image> chevron-left: @image-url("../assets/icons/chevron-left.svg");
    out property <image> chevron-right: @image-url("../assets/icons/chevron-right.svg");
    // Back and forward in the page tab history (the top bar buttons, IA section 6; planned feature A).
    out property <image> arrow-left: @image-url("../assets/icons/arrow-left.svg");
    out property <image> arrow-right: @image-url("../assets/icons/arrow-right.svg");
    out property <image> chevrons-up-down: @image-url("../assets/icons/chevrons-up-down.svg");
