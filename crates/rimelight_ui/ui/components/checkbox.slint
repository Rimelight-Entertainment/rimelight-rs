// Checkbox (S5): a boolean or tri-state choice with a label. Own component, not the std-widgets
// CheckBox: the Fluent style colours it from its own FluentPalette global, which Tokens cannot reach, and it has no
// indeterminate state and no size (README, "Slint port" S5).
//
// unchecked, checked and indeterminate; sizes
// sm (16 px) and md (20 px); disabled; invalid; and the label on the right. An indeterminate box becomes checked when it
// is toggled, a checked box becomes unchecked, and an unchecked box becomes checked.
//
// Keyboard: a FocusScope takes Tab focus. Space toggles. Enter does nothing (WAI-ARIA checkbox pattern). A pointer click
// toggles but does not move keyboard focus, so the 2 px focus ring (Tokens.focus-ring) shows only for keyboard focus.
// Disabled: not a Tab stop, and ignores clicks and keys.
//
// Accessibility: role checkbox, checked from the state. Slint's accessible-checked is a bool, so the indeterminate state
// is reported as accessible-value "mixed" (a convention, not a Slint tri-state).
import { Tokens } from "@rimelight_design/tokens.slint";
import { Type } from "../typography.slint";
import { Icons } from "../icons.slint";

export enum CheckState { unchecked, checked, indeterminate }
export enum CheckboxSize { sm, md }

export component Checkbox inherits Rectangle {
    // The state, two-way: the box edits it and the caller can set it.
    in-out property <CheckState> check-state: CheckState.unchecked;
    in property <string> text;
    // Accessible name. Empty means the label text is the name.
    in property <string> accessible-name;
    in property <CheckboxSize> size: CheckboxSize.md;
    in property <bool> enabled: true;
    // Red border. Inside a Field, the caller passes `field.invalid || own-flag`.
    in property <bool> invalid: false;
    // Forced look for captures: 2 shows the focus ring. Real keyboard focus takes precedence.
    in property <int> forced-state: 0;
    // True while the FocusScope holds keyboard focus.
    out property <bool> has-focus: fs.has-focus;
    // The checked value after the change: true when the box is now checked.
    callback changed(bool);

    property <length> box: root.size == CheckboxSize.sm ? 16px : 20px;
    property <bool> filled: root.check-state != CheckState.unchecked;
    property <bool> focused: fs.has-focus || root.forced-state == 2;
    property <color> box-fill: !root.enabled
        ? (root.filled ? Tokens.disabled-fill : Tokens.disabled-surface)
        : (root.filled ? Tokens.accent-default : Tokens.surface-base);
    property <color> box-border: !root.enabled
        ? (root.filled ? Tokens.disabled-fill : Tokens.disabled-border)
        : (root.invalid ? Tokens.status-danger : (root.filled ? Tokens.accent-default : Tokens.border-strong));
    property <color> mark: !root.enabled
        ? Tokens.surface-raised
        : (root.filled ? Tokens.text-on-accent : Tokens.text-primary);
    property <color> label-color: root.enabled ? Tokens.text-primary : Tokens.disabled-text;

    // indeterminate or unchecked becomes checked; checked becomes unchecked.
    function toggle() {
        if (root.enabled) {
            if (root.check-state == CheckState.checked) {
                root.check-state = CheckState.unchecked;
            } else {
                root.check-state = CheckState.checked;
            }
            root.changed(root.check-state == CheckState.checked);
        }
    }

    // Test hook: a click on the row, as its pointer area does (toggles unless disabled).
    public function test-click() {
        root.toggle();
    }

    accessible-role: checkbox;
    accessible-label: root.accessible-name != "" ? root.accessible-name : root.text;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.check-state == CheckState.checked;
    accessible-value: root.check-state == CheckState.indeterminate ? "mixed" : "";
    accessible-action-default => { root.toggle(); }

    min-width: 16px;
    height: max(Tokens.size-control-sm, layout.preferred-height);
    horizontal-stretch: 0;

    layout := HorizontalLayout {
        spacing: Tokens.space-2;
        alignment: start;

        // A full-height cell, so the box can be centred vertically with `y` (layouts would otherwise pin it to the top).
        Rectangle {
            width: root.box;
            min-height: root.box;

            box-shape := Rectangle {
                width: root.box;
                height: root.box;
                y: (parent.height - self.height) / 2;
                border-radius: Tokens.radius-r4;
                background: root.box-fill;
                border-width: 1px;
                border-color: root.box-border;

                if root.check-state == CheckState.checked : Image {
                    source: Icons.check;
                    colorize: root.mark;
                    width: root.box - Tokens.space-1;
                    height: root.box - Tokens.space-1;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    accessible-role: none;
                }
                if root.check-state == CheckState.indeterminate : Rectangle {
                    width: root.size == CheckboxSize.sm ? Tokens.space-2 : Tokens.space-3;
                    height: 2px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: root.mark;
                }
            }

            // The focus ring sits outside the box, with a 2 px gap, so it shows on a filled box too (an inner ring in
            // the accent colour would match the fill).
            focus-ring := Rectangle {
                visible: root.focused;
                x: -4px;
                y: (parent.height - root.box) / 2 - 4px;
                width: root.box + 8px;
                height: root.box + 8px;
                border-radius: Tokens.radius-r6;
                border-width: 2px;
                border-color: Tokens.focus-ring;
                background: transparent;
            }
        }

        if root.text != "" : Text {
            horizontal-stretch: 1;
            text: root.text;
            color: root.label-color;
            font-family: Type.label.family;
            font-size: Type.label.size;
            font-weight: Type.label.weight;
            vertical-alignment: center;
            wrap: word-wrap;
            accessible-role: none;
        }
    }

    // The whole row toggles on a click, the label included. Declared after the layout so it is on top.
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.toggle(); }
    }

    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Space) {
                root.toggle();
                return accept;
            }
            return reject;
        }
    }
}
