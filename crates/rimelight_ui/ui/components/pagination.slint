// Pagination (P0.17 batch 2). Previous and Next buttons with page numbers between them. Pages are 1-based.
//
// Page numbers. Seven slots hold the numbers. With seven pages or fewer every page has a slot. With more, the first and
// last pages always show. Near the start the slots are 1 to 5, an ellipsis, then the last page. Near the end they are the
// first page, an ellipsis, then the last five. In the middle they are the first page, an ellipsis, the current page with
// one neighbour on each side, an ellipsis, then the last page. An ellipsis is text and is not a control.
//
// Keyboard: Previous, each page number and Next are Button Tab stops, in order. Enter or Space presses the focused one.
// The current page and a disabled Previous or Next are not used: the current page button is drawn as primary and does not
// report a change. Previous is disabled on page 1 and Next on the last page, so neither is a Tab stop there.
//
// Callbacks. `page-changed(page)` fires once for each press that picks a different page, with the new 1-based page. `page`
// is set before it runs. A caller that changes `page` from outside gets no callback.
import { Tokens } from "@rimelight_design/tokens.slint";
import { Button, ButtonVariant, ButtonSize } from "button.slint";
import { Icons } from "../icons.slint";
import { Type } from "../typography.slint";

export component Pagination inherits HorizontalLayout {
    // The number of pages, at least 1.
    in property <int> total: 1;
    // The current page, 1-based, two-way.
    in-out property <int> page: 1;
    callback page-changed(int);

    // The seven slot keys, one per slot. Each slot's page comes from `slot-value`.
    property <[int]> slot-keys: [0, 1, 2, 3, 4, 5, 6];

    // The number shown in slot k: a page (1-based), -1 for an ellipsis, -2 for an empty slot.
    pure function slot-value(k: int) -> int {
        if (root.total <= 7) {
            if (k < root.total) {
                return k + 1;
            }
            return -2;
        }
        if (root.page <= 4) {
            if (k == 5) {
                return -1;
            }
            if (k == 6) {
                return root.total;
            }
            return k + 1;
        }
        if (root.page >= root.total - 3) {
            if (k == 0) {
                return 1;
            }
            if (k == 1) {
                return -1;
            }
            return root.total - 6 + k;
        }
        if (k == 0) {
            return 1;
        }
        if (k == 1) {
            return -1;
        }
        if (k == 5) {
            return -1;
        }
        if (k == 6) {
            return root.total;
        }
        return root.page + k - 3;
    }

    // Picks a page when it is in range and not the current one.
    function choose(n: int) {
        if (n >= 1 && n <= root.total && n != root.page) {
            root.page = n;
            root.page-changed(n);
        }
    }

    // Whether a slot shows page `n`.
    pure function page-shown(n: int) -> bool {
        return root.slot-value(0) == n || root.slot-value(1) == n || root.slot-value(2) == n
            || root.slot-value(3) == n || root.slot-value(4) == n || root.slot-value(5) == n
            || root.slot-value(6) == n;
    }

    // Test hooks. `test-click-page` is the click of the page button for `n` (only a shown page button reports, and the
    // current page does not). `test-next` is the click of Next. `test-shown` and `test-has-ellipsis` report what is drawn.
    public function test-click-page(n: int) {
        if (root.page-shown(n)) {
            root.choose(n);
        }
    }
    public function test-next() {
        if (root.page < root.total) {
            root.choose(root.page + 1);
        }
    }
    public function test-shown(n: int) -> bool {
        return root.page-shown(n);
    }
    public function test-has-ellipsis() -> bool {
        return root.slot-value(1) == -1 || root.slot-value(5) == -1;
    }

    spacing: Tokens.space-1;
    alignment: start;

    Button {
        text: "Previous";
        variant: ButtonVariant.ghost;
        size: ButtonSize.md;
        leading-icon: Icons.chevron-left;
        enabled: root.page > 1;
        clicked => { root.choose(root.page - 1); }
    }

    for key[i] in root.slot-keys : HorizontalLayout {
        spacing: Tokens.space-0;
        alignment: start;

        if root.slot-value(i) == -1 : Text {
            text: "…";
            color: Tokens.text-muted;
            font-family: Type.body.family;
            font-size: Type.body.size;
            font-weight: Type.body.weight;
            vertical-alignment: center;
            accessible-role: text;
            accessible-label: "…";
        }
        if root.slot-value(i) > 0 : Button {
            text: "\{root.slot-value(i)}";
            variant: root.slot-value(i) == root.page ? ButtonVariant.primary : ButtonVariant.ghost;
            size: ButtonSize.md;
            square: true;
            clicked => { root.choose(root.slot-value(i)); }
        }
    }

    Button {
        text: "Next";
        variant: ButtonVariant.ghost;
        size: ButtonSize.md;
        trailing-icon: Icons.chevron-right;
        enabled: root.page < root.total;
        clicked => { root.choose(root.page + 1); }
    }
}
