// Test markup for tests/ui/menu.rs, compiled once by crates/rimelight_ui_test_slint (decision 0037, BT.4).
import { Button, ButtonVariant } from "@rimelight_ui/components/button.slint";
import { Menu, MenuItem, MenuKind, MenuChecked, MenuNav } from "@rimelight_ui/components/menu.slint";
import { Icons } from "@rimelight_ui/icons.slint";
export { MenuNav, MenuItem }

export component MenuForm inherits Window {
    width: 420px;
    height: 420px;

    // Rows, by index: 0 Undo (disabled), 1 New, 2 rule, 3 heading View, 4 Wrap (checked), 5 More (submenu),
    // 6 Duplicate (child of More), 7 Print (child, disabled), 8 Delete (danger).
    property <[MenuItem]> items: [
        { id: "undo", kind: MenuKind.item, label: "Undo", icon: Icons.x, shortcut: "Ctrl+Z", disabled: true, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "new", kind: MenuKind.item, label: "New file", icon: Icons.plus, shortcut: "Ctrl+N", disabled: false, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "sep", kind: MenuKind.separator, label: "", icon: Icons.x, shortcut: "", disabled: false, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "h", kind: MenuKind.heading, label: "View", icon: Icons.x, shortcut: "", disabled: false, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "wrap", kind: MenuKind.item, label: "Word wrap", icon: Icons.x, shortcut: "", disabled: false, danger: false, checked: MenuChecked.on, parent: "" },
        { id: "more", kind: MenuKind.submenu, label: "More", icon: Icons.x, shortcut: "", disabled: false, danger: false, checked: MenuChecked.none, parent: "" },
        { id: "dup", kind: MenuKind.item, label: "Duplicate", icon: Icons.x, shortcut: "Ctrl+D", disabled: false, danger: false, checked: MenuChecked.none, parent: "more" },
        { id: "print", kind: MenuKind.item, label: "Print", icon: Icons.x, shortcut: "", disabled: true, danger: false, checked: MenuChecked.none, parent: "more" },
        { id: "delete", kind: MenuKind.item, label: "Delete", icon: Icons.x, shortcut: "Del", disabled: false, danger: true, checked: MenuChecked.none, parent: "" },
    ];

    out property <int> fired: 0;
    out property <string> last-id: "";
    out property <bool> open: menu.menu-open;
    out property <int> highlight: menu.highlight;
    out property <string> expanded: menu.expanded-id;
    out property <bool> trigger-focused: trig.has-focus;

    public function open-menu() { menu.open(); }

    // Test hook: presses and clicks the trigger, as a click on it does (its press, then its click).
    public function click-trigger() { trig.pointer-pressed(); trig.clicked(); }
    // Test hook: a click on item `index` of the menu, as its row does (a disabled item takes no click).
    public function click-item(index: int) { menu.test-click-item(index); }

    trig := Button {
        x: 20px;
        y: 20px;
        width: 120px;
        text: "Actions";
        accessible-name: "Actions";
        variant: ButtonVariant.secondary;
        down-pressed => { menu.open(); }
        pointer-pressed => { menu.trigger-pressed(); }
        clicked => {
            trig.focus-me();
            menu.trigger-clicked();
        }
    }

    menu := Menu {
        x: 20px;
        y: 20px;
        accessible-name: "Menu actions";
        anchor-height: trig.height;
        menu-width: 220px;
        items: root.items;
        selected(id) => {
            root.fired += 1;
            root.last-id = id;
        }
    }
}
