// BoardPage (ST5.4, T-BOARD). Columns of cards side by side in a horizontal scroll area. Each column has a name, its card count
// through its cards, and an Add card button at the end.
//
// Moving a card. Drag a card over another column and release: the column under the pointer gets the card. The Left and
// Right arrows move the focused card one column, which is the keyboard way to do the same. Both report `moved(key, column)`,
// and the caller applies the move and sets `board` again. The page does not change its own data, so a refused move leaves
// the card where it was. The caller sets `move-error` to say why.
//
// Drop targets. The page asks the caller which column is under a point through `column-at` (x in px from the first column,
// the column width, the gap, and the count; the answer is a column index or -1). Wire it to `board::drop_column` in
// rimelight_ui_kit. Without that callback no column is under the pointer and a drag drops nowhere.
//
// Load state, empty and error come from `state`, through PageState. The board is drawn only when `state` is loaded.
import { Tokens } from "@rimelight_design/tokens.slint";
import { Type } from "@rimelight_ui/typography.slint";
import { ScrollView } from "std-widgets.slint";
import { Button, ButtonVariant, ButtonSize } from "@rimelight_ui/components/button.slint";
import { PageLoadState, PageState } from "@rimelight_ui/components/page-state.slint";
import { Banner, BannerTone } from "@rimelight_ui/components/banner.slint";

// One card. `detail` is a second line under the title (empty for none).
export struct BoardItem {
    key: string,
    title: string,
    detail: string,
}

// One column: its name and its cards, top first.
export struct BoardLane {
    name: string,
    cards: [BoardItem],
}

// A card. It is a press-and-drag target, and a focus stop for the arrow keys.
component BoardCardView inherits Rectangle {
    in property <BoardItem> item;
    // The column this card is in.
    in property <int> column;
    // Pressed and dragged: the pointer's x in window px. Sent while the button is held.
    callback drag-moved(string, length);
    // Released: the card's key, its column and the pointer's x in window px.
    callback dropped(string, int, length);
    // Left or Right with the card focused: the key, its column and -1 or 1.
    callback step(string, int, int);
    // A press that was not a drag.
    callback picked(string);

    // Set when the pointer moved while pressed, so the click that follows a drag does not also pick the card.
    property <bool> dragged: false;

    background: Tokens.surface-raised;
    border-width: fs.has-focus ? 2px : 1px;
    border-color: fs.has-focus ? Tokens.focus-ring : Tokens.border-subtle;
    border-radius: Tokens.radius-r4;
    height: lay.preferred-height;

    lay := VerticalLayout {
        padding: Tokens.space-2;
        spacing: Tokens.space-1;

        Text {
            text: root.item.title;
            color: Tokens.text-primary;
            wrap: word-wrap;
            font-family: Type.body-strong.family;
            font-size: Type.body-strong.size;
            font-weight: Type.body-strong.weight;
        }
        if root.item.detail != "" : Text {
            text: root.item.detail;
            color: Tokens.text-muted;
            wrap: word-wrap;
            font-family: Type.caption.family;
            font-size: Type.caption.size;
            font-weight: Type.caption.weight;
        }
    }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) {
                root.step(root.item.key, root.column, -1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.step(root.item.key, root.column, 1);
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        accessible-role: button;
        accessible-label: root.item.title;
        moved => {
            if (self.pressed) {
                root.dragged = true;
                root.drag-moved(root.item.key, self.absolute-position.x + self.mouse-x);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dragged = false;
                fs.focus();
            }
            if (event.kind == PointerEventKind.up && root.dragged) {
                root.dropped(root.item.key, root.column, self.absolute-position.x + self.mouse-x);
            }
        }
        clicked => {
            if (!root.dragged) {
                root.picked(root.item.key);
            }
        }
    }
}

export component BoardPage inherits Rectangle {
    // The page heading.
    in property <string> title;
    // loading, loaded, empty or error. Anything but loaded hides the board.
    in property <PageLoadState> state: PageLoadState.loading;
    in property <string> error;
    in property <image> empty-icon;
    in property <string> empty-title: "Nothing on the board";
    in property <string> empty-description;
    in property <string> error-description: "The board could not be loaded.";
    // The columns, in order.
    in property <[BoardLane]> board;
    // Each column's width. The gap between columns is space-3.
    in property <length> column-width: 272px;
    // The Add card button at the foot of each column.
    in property <string> add-label: "Add card";
    // The message for a move the caller refused (empty hides it). Shown above the board.
    in property <string> move-error;

    // The column under a point, from the caller: x in px from the first column, the column width in px, the gap in px and
    // the count. Returns a column index, or -1. See the comment at the top of this file.
    callback column-at(float, float, float, int) -> int;

    callback opened();
    callback retry();
    // A card moved: its key and the column it goes to (an index into `board`).
    callback moved(string, int);
    // The Add card button of a column was pressed: that column's index.
    callback add-card(int);
    // A card was opened (a press that was not a drag): its key.
    callback picked(string);

    // The key of the card being dragged, and the column it is over (-1 for none).
    property <string> drag-key;
    property <int> drag-over: -1;

    background: transparent;
    init => {
        root.opened();
    }

    // Starts or updates a drag: the column under the pointer is shown as the drop target.
    function drag(key: string, x: length) {
        root.drag-key = key;
        root.drag-over = root.column-at(
            (x - board-scroll.absolute-position.x - board-scroll.content-x) / 1px,
            root.column-width / 1px,
            Tokens.space-3 / 1px,
            root.board.length);
    }

    // Ends a drag. Dropped over another column, the card moves there. Dropped anywhere else, nothing moves.
    function drop(key: string, source: int, x: length) {
        root.drag-over = -1;
        root.drag-key = "";
        let target = root.column-at(
            (x - board-scroll.absolute-position.x - board-scroll.content-x) / 1px,
            root.column-width / 1px,
            Tokens.space-3 / 1px,
            root.board.length);
        if (target >= 0 && target != source) {
            root.moved(key, target);
        }
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: Tokens.space-4;
        spacing: Tokens.space-3;

        // Header: the title and nothing else. The columns carry their own Add card buttons.
        Text {
            text: root.title;
            color: Tokens.text-primary;
            overflow: elide;
            font-family: Type.heading.family;
            font-size: Type.heading.size;
            font-weight: Type.heading.weight;
            accessible-role: text;
            accessible-label: root.title;
        }

        if root.move-error != "" : Banner {
            tone: BannerTone.danger;
            title: root.move-error;
        }

        if root.state != PageLoadState.loaded : PageState {
            state: root.state;
            icon: root.empty-icon;
            empty-title: root.empty-title;
            empty-description: root.empty-description;
            error-description: root.error-description;
            error-details: root.error;
            retry => {
                root.retry();
            }
        }

        // Always in the tree, so the drop functions can read its scroll offset. It is hidden until the board is loaded.
        board-scroll := ScrollView {
            visible: root.state == PageLoadState.loaded;
            vertical-stretch: root.state == PageLoadState.loaded ? 1 : 0;
            horizontal-scrollbar-policy: as-needed;
            vertical-scrollbar-policy: always-off;

            HorizontalLayout {
                height: parent.height;
                spacing: Tokens.space-3;
                padding-bottom: Tokens.space-1;

                for lane[index] in root.board : Rectangle {
                    width: root.column-width;
                    height: parent.height;
                    border-radius: Tokens.radius-r6;
                    clip: true;
                    background: root.drag-over == index ? Tokens.surface-raised : Tokens.surface-sunken;
                    border-width: root.drag-over == index ? 2px : 1px;
                    border-color: root.drag-over == index ? Tokens.focus-ring : Tokens.border-subtle;

                    VerticalLayout {
                        padding: Tokens.space-2;
                        spacing: Tokens.space-2;

                        HorizontalLayout {
                            height: 28px;
                            padding-left: Tokens.space-1;
                            Text {
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                text: lane.name;
                                color: Tokens.text-primary;
                                overflow: elide;
                                font-family: Type.body-strong.family;
                                font-size: Type.body-strong.size;
                                font-weight: Type.body-strong.weight;
                            }
                            Text {
                                vertical-alignment: center;
                                text: lane.cards.length;
                                color: Tokens.text-muted;
                                font-family: Type.caption.family;
                                font-size: Type.caption.size;
                                font-weight: Type.caption.weight;
                            }
                        }

                        for card in lane.cards : BoardCardView {
                            item: card;
                            column: index;
                            drag-moved(key, x) => {
                                root.drag(key, x);
                            }
                            dropped(key, source, x) => {
                                root.drop(key, source, x);
                            }
                            step(key, source, direction) => {
                                if (source + direction >= 0 && source + direction < root.board.length) {
                                    root.moved(key, source + direction);
                                }
                            }
                            picked(key) => {
                                root.picked(key);
                            }
                        }

                        Button {
                            text: root.add-label;
                            variant: ButtonVariant.ghost;
                            size: ButtonSize.sm;
                            accessible-name: root.add-label + " to " + lane.name;
                            clicked => {
                                root.add-card(index);
                            }
                        }
                    }
                }
            }
        }
    }
}
