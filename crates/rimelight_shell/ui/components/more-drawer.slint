// Phone More drawer (OQ24, OQ26, OQ29; IA section 8). The panel that the More tab opens on a phone. Its top holds the
// running timer (shown only while `timer-running`), the background jobs (shown only while `jobs` is not empty), and the
// status bar tools that apply on a phone: Record, Language and Theme. Its middle lists the six areas that have no tab
// (`areas`); a pick reports its index, and the shell shows that area's tree in the drawer. Its footer holds About, Report
// Issue and Settings. Fullscreen and Shortcuts are not shown on a phone. The connection state is not here (banner only).
//
// Drawn from the Tokens global only, in the sidebar colours. The shell sets every property and answers every callback.
import { ScrollView } from "std-widgets.slint";
import { Tokens } from "@rimelight_design/tokens.slint";
import { Icons } from "@rimelight_ui/icons.slint";
import { Type } from "@rimelight_ui/typography.slint";
import { RailItem } from "rail.slint";
import { JobItem } from "status-bar.slint";

// One row of the drawer: an optional icon, the text, an optional value on the right, and a check on the chosen item.
component DrawerRow inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> value;
    in property <bool> checked;
    callback clicked();

    height: Tokens.size-control-sm + Tokens.space-2;
    background: ta.has-hover ? Tokens.sidebar-hover-bg : transparent;
    border-radius: Tokens.radius-r4;

    HorizontalLayout {
        padding-left: Tokens.space-4;
        padding-right: Tokens.space-4;
        spacing: Tokens.space-2;
        alignment: start;

        if root.icon.width > 0 : Image {
            width: Icons.medium-size;
            height: Icons.medium-size;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: Tokens.sidebar-text;
        }

        Text {
            text: root.text;
            color: Tokens.sidebar-text;
            font-family: Type.body.family;
            font-size: Type.body.size;
            font-weight: Type.body.weight;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.value != "" : Text {
            text: root.value;
            color: Tokens.sidebar-text-muted;
            font-family: Type.caption.family;
            font-size: Type.caption.size;
            font-weight: Type.caption.weight;
            vertical-alignment: center;
        }

        if root.checked : Image {
            width: Icons.small-size;
            height: Icons.small-size;
            y: (parent.height - self.height) / 2;
            source: Icons.check;
            colorize: Tokens.sidebar-text;
        }
    }

    ta := TouchArea {
        accessible-role: button;
        accessible-label: root.text;
        clicked => { root.clicked(); }
    }
}

export component MoreDrawer inherits Rectangle {
    // The running timer (OQ18, OQ29). Shown only while `timer-running` is true.
    in property <bool> timer-running: false;
    in property <string> timer-text: "";
    // Background jobs. Shown only while the list is not empty; the count is shown, the jobs are not listed here.
    in property <[JobItem]> jobs: [];
    // The status bar tools that apply on a phone: Record, Language (a choice of `language-names`, the checked one is
    // `language-index`) and Theme (`theme-label` and `theme-icon`, the current mode).
    in property <image> theme-icon;
    in property <string> theme-label: "Theme: system";
    in property <[string]> language-names: ["English", "Português"];
    in property <int> language-index: 0;
    // The areas without a tab, in order.
    in property <[RailItem]> areas;

    callback record-clicked();
    callback theme-clicked();
    callback language-picked(int);
    callback area-activated(int);
    // The footer. Each only reports its click; the shell opens the screen.
    callback about-clicked();
    callback report-issue-clicked();
    callback settings-clicked();

    // True while the Language choices are listed under the Language row.
    property <bool> language-open: false;

    // Test hooks: the state the drawn rows show. The static rows report fixed values (their markup is fixed).
    out property <string> test-timer-text: root.timer-running ? root.timer-text : "";
    out property <bool> test-jobs-shown: root.jobs.length > 0;
    out property <int> test-jobs-count: root.jobs.length;
    out property <bool> test-language-open: root.language-open;
    out property <bool> test-has-language: language-row.visible;
    out property <bool> test-has-record: record-row.visible;
    out property <bool> test-has-fullscreen: false;
    out property <bool> test-has-shortcuts: false;
    out property <bool> test-has-about: about-row.visible;
    out property <bool> test-has-report-issue: report-row.visible;
    out property <bool> test-has-settings: settings-row.visible;
    out property <[string]> test-language-choices: root.language-names;

    // Mirrors the Language row's click (the same toggle as the row's `clicked`).
    public function test-click-language() {
        root.language-open = !root.language-open;
    }

    // Mirrors a Language choice's click: report the pick, then close the list (same order as the row's `clicked`).
    public function test-pick-language(index: int) {
        root.language-picked(index);
        root.language-open = false;
    }

    width: Tokens.size-sidebar-width;
    background: Tokens.sidebar-bg;
    clip: true;

    // The shell places the drawer below the window's top safe-area inset (its `y`), so the inset is not added again here.
    // The padding is a fixed minimum, so the first row never sits on the top edge (the headless capture reports zero insets).
    VerticalLayout {
        padding-top: Tokens.space-4;
        padding-bottom: Tokens.space-2;

        // Top: the timer, the jobs count, then the tools.
        if root.timer-running : Text {
            text: root.timer-text;
            height: Tokens.size-control-sm;
            color: Tokens.sidebar-text;
            font-family: Type.caption.family;
            font-size: Type.caption.size;
            font-weight: Type.caption.weight;
            horizontal-alignment: left;
            vertical-alignment: center;
            x: Tokens.space-4;
            accessible-role: text;
            accessible-label: root.timer-text;
        }

        if root.jobs.length > 0 : HorizontalLayout {
            height: Tokens.size-control-sm;
            padding-left: Tokens.space-4;
            padding-right: Tokens.space-4;
            spacing: Tokens.space-2;

            Text {
                text: "Background jobs";
                color: Tokens.sidebar-text;
                font-family: Type.body.family;
                font-size: Type.body.size;
                font-weight: Type.body.weight;
                vertical-alignment: center;
                accessible-role: text;
                accessible-label: "Background jobs";
            }

            Text {
                text: "\{root.jobs.length}";
                color: Tokens.sidebar-text-muted;
                font-family: Type.caption.family;
                font-size: Type.caption.size;
                font-weight: Type.caption.weight;
                vertical-alignment: center;
                accessible-role: text;
                accessible-label: "\{root.jobs.length}";
            }
        }

        record-row := DrawerRow {
            icon: Icons.video;
            text: "Record";
            clicked => { root.record-clicked(); }
        }

        language-row := DrawerRow {
            icon: Icons.languages;
            text: "Language";
            value: root.language-names[root.language-index];
            clicked => { root.language-open = !root.language-open; }
        }

        if root.language-open : VerticalLayout {
            for name[index] in root.language-names : DrawerRow {
                text: name;
                checked: index == root.language-index;
                clicked => {
                    root.language-picked(index);
                    root.language-open = false;
                }
            }
        }

        DrawerRow {
            icon: root.theme-icon;
            text: root.theme-label;
            clicked => { root.theme-clicked(); }
        }

        Rectangle {
            height: 1px;
            background: Tokens.sidebar-divider;
        }

        // The areas without a tab. A long list scrolls; the footer stays in view.
        ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            content-height: areas-list.height;

            areas-list := VerticalLayout {
                width: parent.width;
                height: root.areas.length * (Tokens.size-control-sm + Tokens.space-2);

                for item[index] in root.areas : DrawerRow {
                    icon: item.icon;
                    text: item.label;
                    clicked => { root.area-activated(index); }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Tokens.sidebar-divider;
        }

        // Footer: About, Report Issue, Settings.
        about-row := DrawerRow {
            icon: Icons.circle-question-mark;
            text: "About";
            clicked => { root.about-clicked(); }
        }

        report-row := DrawerRow {
            icon: Icons.bug;
            text: "Report Issue";
            clicked => { root.report-issue-clicked(); }
        }

        settings-row := DrawerRow {
            icon: Icons.settings;
            text: "Settings";
            clicked => { root.settings-clicked(); }
        }
    }
}
