// The block editor's document canvas, laid out like the web editor: a centred column with the page title and
// description, then the blocks. Each block has a gutter with + and the ⋮⋮ grip (editor-row.slint). The insert, mention,
// emoji and block menus open under the row they belong to; the link prompt opens centred.
//
// The page chrome is the app's: it places the toolbar pieces, the locale switcher, the presence strip, the block
// inspector and the comment panel where its layout wants them. They are exported here and read the same global.
//
// All state and callbacks live in the exported global `EditorBridge`, not on `BlockEditor`. The app places
// `BlockEditor {}` anywhere in its own window with no bindings, and Rust reaches the state through the window's global
// (`wire_block_editor!` in src/lib.rs). One editor is live per window at a time, because the global is one per window.
// The app's root markup must re-export `EditorBridge` so Rust can name it:
//
//   import { BlockEditor, EditorBridge } from "@rimelight_editor/block-editor.slint";
//   export { EditorBridge }
//
// Phone (`compact`): the format toolbar sits above the virtual keyboard, the inspector and comment panel are the app's
// bottom sheets, and the gutter stays visible.
import { Tokens } from "@rimelight_design/tokens.slint";
import { Type } from "@rimelight_ui/typography.slint";
import { Icons } from "@rimelight_ui/icons.slint";
import { ScrollArea } from "@rimelight_ui/components/scroll-area.slint";
import { EditorRowView } from "editor-row.slint";
import { InsertMenu } from "insert-menu.slint";
import { MentionPicker } from "mention-picker.slint";
import { EmojiPicker } from "emoji-picker.slint";
import { BlockMenu } from "block-menu.slint";
import { LinkPrompt } from "link-prompt.slint";
import { LocaleSwitcher } from "locale-switcher.slint";
import { CommentPanel } from "comment-panel.slint";
import { Inspector } from "inspector.slint";
import { FormatToolbar } from "format-toolbar.slint";
import {
    EditorRow, RemoteCaret, InsertItem, MentionItem, InspectorField, KeyOutcome, EmojiItem, BlockMenuItem, LocaleItem,
    CommentItem, PresenceItem
} from "types.slint";

// The page chrome pieces, for the app's layout.
export { LocaleSwitcher, CommentPanel, Inspector, FormatToolbar }

// Every property and callback the editor shares with Rust. The Rust side sets the properties and calls `on_*` on this
// global of the window. Within the markup, the editor reads and calls them here.
export global EditorBridge {
    // ----- Set by Rust (wire_block_editor!) -----
    in-out property <[EditorRow]> rows;
    in-out property <[RemoteCaret]> carets;
    in-out property <[LocaleItem]> locales;
    in-out property <[PresenceItem]> presence;
    // The page's title and description in the current locale.
    in-out property <string> title;
    in-out property <string> description;
    in-out property <bool> insert-open: false;
    in-out property <[InsertItem]> insert-items;
    in-out property <int> insert-selected: 0;
    in-out property <bool> mention-open: false;
    in-out property <[MentionItem]> mention-items;
    in-out property <int> mention-selected: 0;
    in-out property <bool> emoji-open: false;
    in-out property <[EmojiItem]> emoji-items;
    in-out property <int> emoji-selected: 0;
    in-out property <bool> block-menu-open: false;
    in-out property <[BlockMenuItem]> block-menu-items;
    in-out property <int> block-menu-selected: 0;
    in-out property <bool> link-open: false;
    in-out property <string> link-url;
    in-out property <bool> link-new-tab: false;
    in-out property <bool> link-has-link: false;
    in-out property <bool> comments-open: false;
    in-out property <[CommentItem]> comments;
    // The comment panel's scope: a block id, or "" for the page. `comment-block` is the focused block.
    in-out property <string> comment-scope;
    in-out property <string> comment-block;
    in-out property <[InspectorField]> inspector-fields;
    // Focus: the display row, and the caret as byte offsets in its text. `focus-serial` changes on every focus request.
    in-out property <int> focus-row: -1;
    in-out property <int> focus-anchor: 0;
    in-out property <int> focus-head: 0;
    in-out property <int> focus-serial: 0;

    // ----- Set by the app -----
    in-out property <bool> compact: false;
    // The page is shown read-only (published view, or no edit access): no gutter, no typing, no title edits.
    in-out property <bool> read-only: false;
    in-out property <bool> inspector-open: false;
    in-out property <bool> inspector-locked: false;
    // The on-screen keyboard's height in logical pixels while it is shown (0 when hidden). Compact layout only.
    in-out property <length> keyboard-height: 0px;
    // Distance, in logical pixels, that one row of drag moves a block by (the drop target is estimated from it).
    in-out property <length> drag-pitch: 32px;

    // ----- Callbacks to Rust -----
    callback text-edited(int, string);
    callback key(int, KeyEvent) -> KeyOutcome;
    callback caret-moved(int, int, int);
    callback handle-clicked(int);
    callback long-pressed(int);
    // The row's + button: add a block below it and open the insert menu.
    callback add-below(int);
    callback title-edited(string);
    callback description-edited(string);
    callback drag-dropped(int, int, int);
    callback insert-menu-chosen(string);
    callback insert-menu-dismissed();
    callback mention-query(string);
    callback mention-chosen(int);
    callback mention-dismissed();
    callback emoji-chosen(int);
    callback emoji-dismissed();
    callback block-menu-chosen(string);
    callback block-menu-dismissed();
    callback toolbar(string);
    callback link-submitted(string, bool);
    callback link-removed();
    callback link-dismissed();
    callback locale-chosen(string);
    callback comment-submit(string, string, string);
    callback comment-resolve(string);
    callback comment-reopen(string);
    callback comment-jump(string);
    callback comment-scope-changed(string);
    callback comment-closed();
    callback inspector-changed(string, string);
    callback web-block-geometry(string, length, length, length, length, string);
}

export component BlockEditor inherits Rectangle {
    background: Tokens.surface-base;

    // Where the open menu sits: under the row that opened it, in this component's coordinates.
    property <length> menu-y: 120px;
    property <length> column-width: min(root.width - 48px, 860px);
    property <length> column-x: (root.width - root.column-width) / 2;
    property <bool> any-menu: EditorBridge.insert-open || EditorBridge.mention-open || EditorBridge.emoji-open
        || EditorBridge.block-menu-open;

    // A block was released after a drag from its grip. The drop goes `steps` rows away (from the pitch): dropping below
    // a row puts the block after it, dropping above puts it before.
    function drop(from: int, distance: length) {
        let steps = Math.round(distance / EditorBridge.drag-pitch);
        if (steps == 0) {
            return;
        }
        let last = EditorBridge.rows.length - 1;
        let target = max(0, min(last, from + steps));
        let to = steps > 0 ? target + 1 : target;
        EditorBridge.drag-dropped(from, to, EditorBridge.rows[from].depth);
    }

    ScrollArea {
        width: root.width;
        height: root.height;
        accessible-name: "Page";

        HorizontalLayout {
            alignment: center;
            padding-top: 32px;
            padding-bottom: 160px;

            VerticalLayout {
                width: root.column-width;
                spacing: 0px;

                // Title and description, in the column of the text (past the gutter).
                VerticalLayout {
                    padding-left: 52px;
                    padding-right: 36px;
                    spacing: 6px;

                    Rectangle {
                        height: title.preferred-height;
                        title := TextInput {
                            width: parent.width;
                            text: EditorBridge.title;
                            font-family: Type.title.family;
                            font-size: 34px;
                            font-weight: 700;
                            color: Tokens.text-primary;
                            wrap: word-wrap;
                            single-line: true;
                            read-only: EditorBridge.read-only;
                            accessible-label: "Title";
                            edited => {
                                EditorBridge.title-edited(self.text);
                            }
                        }
                        if (EditorBridge.title == "" && !title.has-focus) : Text {
                            x: 0px;
                            text: "Untitled";
                            font-family: Type.title.family;
                            font-size: 34px;
                            font-weight: 700;
                            color: Tokens.text-faint;
                        }
                    }

                    Rectangle {
                        height: max(description.preferred-height, 24px);
                        description := TextInput {
                            width: parent.width;
                            text: EditorBridge.description;
                            font-family: Type.body.family;
                            font-size: 16px;
                            color: Tokens.text-muted;
                            wrap: word-wrap;
                            single-line: false;
                            read-only: EditorBridge.read-only;
                            accessible-label: "Description";
                            edited => {
                                EditorBridge.description-edited(self.text);
                            }
                        }
                        if (EditorBridge.description == "" && !description.has-focus && !EditorBridge.read-only) : Text {
                            x: 0px;
                            text: "Add a description";
                            font-family: Type.body.family;
                            font-size: 16px;
                            color: Tokens.text-faint;
                        }
                    }

                    Rectangle {
                        height: 18px;
                        Rectangle {
                            y: 12px;
                            height: 1px;
                            background: Tokens.border-subtle;
                        }
                    }
                }

                for row[index] in EditorBridge.rows : EditorRowView {
                    entry: row;
                    row-index: index;
                    carets: EditorBridge.carets;
                    compact: EditorBridge.compact;
                    read-only: EditorBridge.read-only;
                    focus-row: EditorBridge.focus-row;
                    focus-anchor: EditorBridge.focus-anchor;
                    focus-head: EditorBridge.focus-head;
                    focus-serial: EditorBridge.focus-serial;
                    menus-open: root.any-menu;

                    text-edited(i, text) => {
                        EditorBridge.text-edited(i, text);
                    }
                    key(i, event) => {
                        return EditorBridge.key(i, event);
                    }
                    caret-moved(i, anchor, head) => {
                        EditorBridge.caret-moved(i, anchor, head);
                    }
                    handle-clicked(i) => {
                        EditorBridge.handle-clicked(i);
                    }
                    long-pressed(i) => {
                        EditorBridge.long-pressed(i);
                    }
                    add-below(i) => {
                        EditorBridge.add-below(i);
                    }
                    anchor(y) => {
                        root.menu-y = y - root.absolute-position.y + 4px;
                    }
                    drag-released(i, distance) => {
                        root.drop(i, distance);
                    }
                    web-block-geometry(key, x, y, w, h, url) => {
                        EditorBridge.web-block-geometry(key, x, y, w, h, url);
                    }
                }

                // An empty page: one button to start.
                if (EditorBridge.rows.length == 0 && !EditorBridge.read-only) : HorizontalLayout {
                    padding-left: 52px;
                    padding-top: 8px;
                    alignment: start;
                    Rectangle {
                        width: start-label.preferred-width + 40px;
                        height: 32px;
                        border-radius: Tokens.radius-control;
                        background: start-touch.has-hover ? Tokens.surface-hover : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 6px;
                            alignment: start;
                            Image {
                                y: (parent.height - self.height) / 2;
                                width: 16px;
                                height: 16px;
                                source: Icons.plus;
                                colorize: Tokens.text-muted;
                            }
                            start-label := Text {
                                text: "Add a block";
                                vertical-alignment: center;
                                font-family: Type.body.family;
                                font-size: Type.body.size;
                                color: Tokens.text-muted;
                            }
                        }
                        start-touch := TouchArea {
                            clicked => {
                                EditorBridge.toolbar("insert");
                            }
                        }
                    }
                }
            }
        }
    }

    // Phone: the toolbar sits on top of the keyboard.
    if (EditorBridge.compact && !EditorBridge.read-only) : FormatToolbar {
        x: 0px;
        y: root.height - EditorBridge.keyboard-height - self.height;
        width: root.width;
        action(name) => {
            EditorBridge.toolbar(name);
        }
    }

    // A pointer press outside an open menu closes it. Above the rows, below the menus.
    if (root.any-menu) : TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        clicked => {
            EditorBridge.insert-menu-dismissed();
            EditorBridge.mention-dismissed();
            EditorBridge.emoji-dismissed();
            EditorBridge.block-menu-dismissed();
        }
    }

    // The menus open under the row that opened them, at the text's left edge, kept inside the editor.
    if (EditorBridge.insert-open) : InsertMenu {
        x: root.column-x + 52px;
        y: min(root.menu-y, root.height - self.height - 8px);
        items: EditorBridge.insert-items;
        selected: EditorBridge.insert-selected;
        chosen(block-type) => {
            EditorBridge.insert-menu-chosen(block-type);
        }
    }

    if (EditorBridge.mention-open) : MentionPicker {
        x: root.column-x + 52px;
        y: min(root.menu-y, root.height - self.height - 8px);
        items: EditorBridge.mention-items;
        selected: EditorBridge.mention-selected;
        query-changed(text) => {
            EditorBridge.mention-query(text);
        }
        chosen(index) => {
            EditorBridge.mention-chosen(index);
        }
    }

    if (EditorBridge.emoji-open) : EmojiPicker {
        x: root.column-x + 52px;
        y: min(root.menu-y, root.height - self.height - 8px);
        items: EditorBridge.emoji-items;
        selected: EditorBridge.emoji-selected;
        chosen(index) => {
            EditorBridge.emoji-chosen(index);
        }
    }

    if (EditorBridge.block-menu-open) : BlockMenu {
        x: root.column-x + 8px;
        y: min(root.menu-y, root.height - self.height - 8px);
        items: EditorBridge.block-menu-items;
        selected: EditorBridge.block-menu-selected;
        chosen(action) => {
            EditorBridge.block-menu-chosen(action);
        }
    }

    if (EditorBridge.link-open) : LinkPrompt {
        x: (root.width - self.width) / 2;
        y: 120px;
        url: EditorBridge.link-url;
        new-tab: EditorBridge.link-new-tab;
        has-link: EditorBridge.link-has-link;
        submitted(url, new-tab) => {
            EditorBridge.link-submitted(url, new-tab);
        }
        removed => {
            EditorBridge.link-removed();
        }
        dismissed => {
            EditorBridge.link-dismissed();
        }
    }
}
