// One block row of the editor (design sections 3, 6, 7, 8 and 10).
//
// Text. A transparent TextInput holds focus, keyboard, IME, caret and selection. A StyledText under it draws the rich
// text from `row.markdown`. The TextInput reports every key before it acts (`key`, which the controller answers with
// `handled` or not) and every edit (`text-edited`, after `caret-moved`).
//
// Remote carets. `carets` holds every co-editor's caret; this row draws the ones whose row is its own.
//
// Handle (desktop). Shown on hover, on the left. A click selects the block; a right click opens the block menu
// (`long-pressed`); a press and drag reports the vertical distance on release (`drag-released`).
//
// Grip (phone, `compact`). Replaces the handle. Press and hold for 450 ms to arm it (the block is selected); release
// without moving opens the block menu; move after arming and release drags the block.
//
// Web-only blocks. The row hosts a WebBlock, which reports its box so the app can put a native web view over it.
import { Tokens } from "@rimelight_design/tokens.slint";
import { Type } from "@rimelight_ui/typography.slint";
import { Icons } from "@rimelight_ui/icons.slint";
import { EditorRow, RemoteCaret, KeyOutcome } from "types.slint";
import { WebBlock } from "web-block.slint";

export component EditorRowView inherits Rectangle {
    in property <EditorRow> row;
    in property <int> row-index;
    in property <[RemoteCaret]> carets;
    in property <int> focus-row: -1;
    in property <int> focus-anchor: 0;
    in property <int> focus-head: 0;
    // Incremented by the page each time the focus is set, so a repeated focus on the same row still moves the caret.
    in property <int> focus-serial: 0;
    in property <bool> menus-open: false;
    in property <bool> compact: false;

    callback text-edited(int, string);
    callback key(int, KeyEvent) -> KeyOutcome;
    callback caret-moved(int, int, int);
    callback handle-clicked(int);
    callback long-pressed(int);
    callback drag-released(int, length);
    callback web-block-geometry(string, length, length, length, length, string);

    out property <bool> hovering: touch.has-hover;

    // Where a press started, for the drag distance on release.
    property <length> press-y;
    // Grip state (compact): `armed` once the hold timer fired; `moved` once the pointer moved while armed.
    property <bool> armed: false;
    property <bool> moved: false;

    // Indent by depth, one step per level.
    property <length> indent: root.row.depth * Tokens.space-6;

    background: root.row.selected ? Tokens.selection : transparent;
    height: layout.preferred-height;

    // Hover tracking covers the whole row. It sits first, so the controls above it take the pointer.
    touch := TouchArea { }

    // Hold timer for the grip. Fires once; the release decides between a menu and a drag.
    // UNSURE: the `Timer` element (interval, running, triggered) in Slint 1.18.
    grip-timer := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            self.running = false;
            root.armed = true;
        }
    }

    // Changes after the focus moves here (a split, a merge, a menu, a move). Focus and caret are set after the text.
    changed focus-serial => {
        if (root.focus-row == root.row-index) {
            input.focus();
            input.set-selection-offsets(root.focus-anchor, root.focus-head);
        }
    }

    layout := HorizontalLayout {
        padding-left: root.indent;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-1;

        // Presence bar: a co-editor is in this block.
        Rectangle {
            width: root.row.presence ? Tokens.space-1 : 0px;
            background: root.row.presence-colour;
        }

        // Desktop handle. Visible on hover, and while the block is selected.
        if (!root.compact) : Rectangle {
            width: Tokens.size-control-sm;
            min-height: root.row.font-size * 1.4;
            opacity: (root.hovering || root.row.selected) ? 1 : 0;

            Image {
                width: Icons.small-size;
                height: Icons.small-size;
                source: Icons.chevrons-up-down;
                colorize: Tokens.text-muted;
            }

            handle := TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.press-y = handle.mouse-y;
                        // UNSURE: PointerEvent.button and PointerEventButton in Slint 1.18.
                        if (event.button == PointerEventButton.right) {
                            root.long-pressed(root.row-index);
                        } else {
                            root.handle-clicked(root.row-index);
                        }
                    }
                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                        root.drag-released(root.row-index, handle.mouse-y - root.press-y);
                    }
                }
            }
        }

        // Phone grip. Replaces the handle (design section 10).
        if (root.compact) : Rectangle {
            width: Tokens.size-control-sm;
            min-height: root.row.font-size * 1.4;
            border-radius: Tokens.radius-control;
            background: root.armed ? Tokens.selection : transparent;

            Image {
                width: Icons.small-size;
                height: Icons.small-size;
                source: Icons.chevrons-up-down;
                colorize: Tokens.text-muted;
            }

            grip := TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.press-y = grip.mouse-y;
                        root.armed = false;
                        root.moved = false;
                        grip-timer.running = true;
                        root.handle-clicked(root.row-index);
                    }
                    if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        grip-timer.running = false;
                        if (root.armed && root.moved) {
                            root.drag-released(root.row-index, grip.mouse-y - root.press-y);
                        } else if (root.armed) {
                            root.long-pressed(root.row-index);
                        }
                        root.armed = false;
                        root.moved = false;
                    }
                }
                moved => {
                    if (root.armed) {
                        root.moved = true;
                    }
                }
            }
        }

        // Text. The StyledText draws, the TextInput takes input.
        content := Rectangle {
            horizontal-stretch: 1;
            min-height: root.row.inline ? root.row.font-size * 1.45 : 0px;

            rendered := StyledText {
                x: 0px;
                y: 0px;
                width: parent.width;
                text: root.row.markdown;
                font-size: root.row.font-size;
                default-color: (root.row.locked || root.row.fallback) ? Tokens.text-muted : Tokens.text-primary;
                link-color: Tokens.accent-text;
                wrap: word-wrap;
            }

            input := TextInput {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: root.row.text;
                font-size: root.row.font-size;
                font-family: root.row.block-type == "CodeBlock" ? Type.code.family : Type.body.family;
                wrap: word-wrap;
                single-line: false;
                // The StyledText above shows the text; this layer only takes input.
                color: transparent;
                selection-background-color: Tokens.selection;
                selection-foreground-color: transparent;
                text-cursor-width: 2px;
                // A fallback row is read-only until the first key creates the locale's text (the controller does that).
                read-only: root.row.locked || !root.row.inline || root.row.fallback;
                enabled: root.row.inline;

                edited => {
                    root.caret-moved(root.row-index, self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                    root.text-edited(root.row-index, self.text);
                }

                key-pressed(event) => {
                    root.caret-moved(root.row-index, self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                    if (root.key(root.row-index, event) == KeyOutcome.handled) {
                        return accept;
                    }
                    return reject;
                }
            }

            if (root.row.placeholder != "" && root.row.text == "") : Text {
                x: 0px;
                y: 0px;
                text: root.row.placeholder;
                font-size: root.row.font-size;
                color: Tokens.text-faint;
            }

            // Remote carets. Positions come from parley (layout.rs) in this row's coordinates.
            for caret in root.carets : Rectangle {
                visible: caret.row == root.row-index;
                x: caret.x;
                y: caret.y;
                width: 2px;
                height: caret.height;
                background: caret.colour;
            }

            if (root.row.web-only) : WebBlock {
                x: 0px;
                y: 0px;
                width: parent.width;
                block-key: root.row.id;
                url: root.row.web-url;
                show-snapshot: root.menus-open;
                geometry-changed(key, x, y, w, h, url) => {
                    root.web-block-geometry(key, x, y, w, h, url);
                }
            }
        }

        // Comment badge: the number of open comments on this block.
        if (root.row.comment-count > 0) : Rectangle {
            width: Tokens.space-6;
            height: Tokens.space-6;
            border-radius: Tokens.radius-control;
            background: Tokens.selection;

            Text {
                text: "" + root.row.comment-count;
                font-family: Type.caption.family;
                font-size: Type.caption.size;
                color: Tokens.text-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // Restricted blocks get a striped edge on the left (design section 9).
    if (root.row.restricted) : Rectangle {
        x: 0px;
        width: Tokens.space-1;
        height: parent.height;
        background: Tokens.border-strong;
    }
}
