// The `@` mention picker (design sections 3 and 6). The entries the app's search returned for the query, one row each.
// The text typed after `@` is the query; the picker's own field lets a pointer user change it. Keyboard keys reach the
// block editor, as with the insert menu.
import { Tokens } from "@rimelight_design/tokens.slint";
import { Type } from "@rimelight_ui/typography.slint";
import { MentionItem } from "types.slint";

export component MentionPicker inherits Rectangle {
    in property <[MentionItem]> items;
    in property <int> selected: 0;
    in-out property <string> query;

    callback query-changed(string);
    callback chosen(int);

    width: 300px;
    background: Tokens.surface-overlay;
    border-color: Tokens.border-subtle;
    border-width: 1px;
    border-radius: Tokens.radius-surface;
    height: column.preferred-height + Tokens.space-2;

    column := VerticalLayout {
        x: Tokens.space-1;
        y: Tokens.space-1;
        width: parent.width - Tokens.space-2;
        spacing: Tokens.space-1;

        Rectangle {
            height: Tokens.size-control-md;
            border-radius: Tokens.radius-control;
            border-color: Tokens.border-subtle;
            border-width: 1px;

            field := TextInput {
                x: Tokens.space-2;
                width: parent.width - Tokens.space-4;
                height: parent.height;
                vertical-alignment: center;
                font-family: Type.body.family;
                font-size: Type.body.size;
                color: Tokens.text-primary;
                text <=> root.query;
                edited => {
                    root.query-changed(self.text);
                }
            }
        }

        for item[index] in root.items : Rectangle {
            height: Tokens.size-menu-row-height;
            border-radius: Tokens.radius-control;
            background: index == root.selected ? Tokens.selection : transparent;

            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                spacing: Tokens.space-2;

                Text {
                    text: item.title;
                    font-family: Type.body-strong.family;
                    font-size: Type.body-strong.size;
                    font-weight: Type.body-strong.weight;
                    color: Tokens.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: item.collection;
                    font-family: Type.caption.family;
                    font-size: Type.caption.size;
                    font-weight: Type.caption.weight;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }

            TouchArea {
                clicked => {
                    root.chosen(index);
                }
            }
        }
    }
}
