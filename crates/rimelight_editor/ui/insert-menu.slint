// The `/` insert menu (design section 6). The list of block types for the typed query, one row each, with the
// highlighted row drawn. The block editor keeps the keyboard (the text keeps focus), so this has no focus of its own:
// Up, Down and Enter arrive through the block editor's key handling, and the pointer chooses by click.
import { Tokens } from "@rimelight_design/tokens.slint";
import { Type } from "@rimelight_ui/typography.slint";
import { Icons } from "@rimelight_ui/icons.slint";
import { InsertItem } from "types.slint";

export component InsertMenu inherits Rectangle {
    in property <[InsertItem]> items;
    in property <int> selected: 0;

    callback chosen(string);

    width: 280px;
    background: Tokens.surface-overlay;
    border-color: Tokens.border-subtle;
    border-width: 1px;
    border-radius: Tokens.radius-surface;
    height: list.preferred-height + Tokens.space-2;

    list := VerticalLayout {
        x: Tokens.space-1;
        y: Tokens.space-1;
        width: parent.width - Tokens.space-2;
        spacing: 0px;

        for item[index] in root.items : Rectangle {
            height: Tokens.size-menu-row-height;
            border-radius: Tokens.radius-control;
            background: index == root.selected ? Tokens.selection : transparent;

            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                spacing: Tokens.space-2;
                alignment: start;

                Image {
                    width: Icons.small-size;
                    height: Icons.small-size;
                    colorize: Tokens.text-muted;
                    // Icon keys map to the Lucide icons the library ships. Unknown keys get the document icon.
                    source: item.icon-key == "minus" ? Icons.minus
                        : item.icon-key == "chevron-right" ? Icons.chevron-right
                        : item.icon-key == "search" ? Icons.search
                        : Icons.file-text;
                }

                Text {
                    text: item.label;
                    font-family: Type.body.family;
                    font-size: Type.body.size;
                    font-weight: Type.body.weight;
                    color: Tokens.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // The registry category, as a faint group name.
                Text {
                    text: item.category;
                    font-family: Type.caption.family;
                    font-size: Type.caption.size;
                    color: Tokens.text-faint;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => {
                    root.chosen(item.block-type);
                }
            }
        }
    }
}
