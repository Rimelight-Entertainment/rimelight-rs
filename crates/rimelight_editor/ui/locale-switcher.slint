// The locale switcher (design section 9, CMS.5 item 5). One chip per locale the page has text in, and one "+" chip per
// offered locale it does not have yet. Choosing a chip shows that locale's rows; a locale with no text shows the English
// text greyed until the user types.
import { Tokens } from "@rimelight_design/tokens.slint";
import { Type } from "@rimelight_ui/typography.slint";
import { LocaleItem } from "types.slint";

// A column of rows, so it fits a side panel: the chosen locale is highlighted, a missing one says "Add".
export component LocaleSwitcher inherits VerticalLayout {
    in property <[LocaleItem]> locales;

    callback chosen(string);

    spacing: 2px;

    for item in root.locales : Rectangle {
        height: 32px;
        border-radius: Tokens.radius-control;
        background: item.active ? Tokens.palette-primary-soft : touch.has-hover ? Tokens.surface-hover : transparent;
        accessible-role: button;
        accessible-label: item.label;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            Text {
                horizontal-stretch: 1;
                text: item.label;
                vertical-alignment: center;
                font-family: Type.body.family;
                font-size: Type.body.size;
                font-weight: item.active ? 600 : 400;
                color: item.present ? Tokens.text-primary : Tokens.text-muted;
            }
            Text {
                text: item.present ? "" : "Add";
                vertical-alignment: center;
                font-family: Type.caption.family;
                font-size: Type.caption.size;
                color: Tokens.text-muted;
            }
        }
        touch := TouchArea {
            clicked => { root.chosen(item.code); }
        }
    }
}
