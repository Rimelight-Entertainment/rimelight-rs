import { LineEdit, Button, ScrollView } from "std-widgets.slint";

export component AppWindow inherits Window {
    width: 900px;
    height: 600px;
    title: "webview spike";

    callback load(string);

    out property <length> host-x: host.absolute-position.x;
    out property <length> host-y: host.absolute-position.y;
    out property <length> host-width: host.width;
    out property <length> host-height: host.height;

    VerticalLayout {
        HorizontalLayout {
            padding: 8px;
            spacing: 8px;
            url-edit := LineEdit {
                horizontal-stretch: 1;
                text: "https://example.com";
            }
            Button {
                text: "Load";
                clicked => { root.load(url-edit.text); }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: "Above the box: this paragraph is ordinary Slint text. Resize the window or scroll this list and the web page inside the box should stay aligned with the box.";
                    wrap: word-wrap;
                }
                host := Rectangle {
                    width: 600px;
                    height: 320px;
                    border-width: 2px;
                    border-color: #888888;
                }
                Text {
                    text: "Below the box: more ordinary Slint text. Slint popups opened over the box will be hidden behind the web view, because a native child window always sits on top of Slint's canvas.";
                    wrap: word-wrap;
                }
            }
        }
    }
}
